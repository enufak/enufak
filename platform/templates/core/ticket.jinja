{% extends 'base.jinja' %}
{% load static %}
{% load crispy_forms_tags %}


{% block title %}Destek Talebi Oluştur{% endblock %}

{% block content %}
<section class="bg-white">
    <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16">
        {% if messages %}
        <div class="max-w-2xl mx-auto mt-4 space-y-2">
            {% for message in messages %}
            <div
                class="p-4 rounded-lg text-white {% if message.tags == 'error' %} bg-red-500 {% elif message.tags == 'success' %} bg-green-500 {% else %} bg-blue-500 {% endif %}">
                {{ message }}
            </div>
            {% endfor %}
        </div>
        {% endif %}


        <form method="post" class="bg-white p-6 rounded-lg shadow">
            {% csrf_token %}
            <div class="space-y-12">
                <div class="border-b border-gray-200 pb-12">
                    <h2 class="text-3xl text-gray-900">Destek Talebi <span class="font-bold">Oluştur</span></h2>
                    <p class="mt-1 text-sm text-gray-600">Fikirlerini ve yaşadığın problemleri buradan bizimle
                        paylaşabilirsin.</p>

                    <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6">
                        <div class="sm:col-span-3">
                            <label for="id_tur" class="text-sm font-medium text-gray-900">Talep Türü</label>
                            <div class="mt-2">
                                <div class="items-center pl-3">
                                    {{ form.tur }}
                                </div>
                            </div>
                        </div>

                        <div class="sm:col-span-3">
                            <label for="id_baslik" class="text-sm font-medium text-gray-900">Başlık</label>
                            <div class="mt-2">
                                <div class="flex items-center pl-3">
                                    {{ form.baslik }}
                                </div>
                            </div>
                        </div>

                        <div class="sm:col-span-6">
                            <label for="id_konu" class="block text-sm font-medium text-gray-900">Konu</label>
                            <div class="mt-2">
                                {{ form.konu }}
                            </div>
                            <p class="mt-3 text-sm text-gray-600">Lütfen detaylı ve açıklayıcı şekilde yazmaya özen
                                gösterin.</p>
                        </div>
                    </div>

                </div>
            </div>

            <div class="mt-6 flex items-center justify-end gap-x-6">
                <button type="submit"
                    class="rounded-md bg-yellow-400 px-3 py-2 text-sm font-semibold text-white hover:bg-yellow-500 focus:ring-2 focus:ring-indigo-600">Gönder</button>
            </div>
        </form>
    </div>
</section>

{% endblock %}