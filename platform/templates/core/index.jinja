{% extends "base.jinja" %}
{% load static %}

{% block title %}İşleri çözmenin en kolay yolu.{% endblock %}

{% block content %}
<section class="bg-white">
    <div class="py-8 px-4 mx-auto max-w-screen-xl text-center lg:py-16">

        <h1 class="text-5xl font-extrabold" style="padding-bottom: 10px;">
            İşleri çözmenin
            <span class="bg-clip-text text-transparent"
                style="background-image: linear-gradient(to right, #fdd14f, #fbe5a3);">
                en kolay
            </span> yolu.
        </h1>
        <p class="mb-8 text-lg font-normal text-gray-500 lg:text-xl sm:px-16 lg:px-48">
            İşlerin büyüklüğüne bakılmaz, çözüm anında gelir. EnUfak ile becerilerinizi bir işe dönüştürebilir,
            karşılaştığınız sorunları alanına hakim kişiler yardımıyla çözebilirsiniz.
        </p>
        <div class="flex flex-col space-y-4 sm:flex-row sm:justify-center sm:space-y-0">
            <a href="/uygulama/"
                class="inline-flex justify-center items-center py-3 px-5 text-base font-medium text-center text-white rounded-lg bg-yellow-500 hover:bg-yellow-600 focus:ring-4 focus:ring-blue-300">
                Hemen başla
                <svg class="w-3.5 h-3.5 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                    fill="none" viewBox="0 0 14 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M1 5h12m0 0L9 1m4 4L9 9" />
                </svg>
            </a>
        </div>
    </div>
</section>

<section class="bg-white">
    <div class="py-8 px-4 mx-auto max-w-screen-md lg:py-16">
        <h2 class="text-4xl text-gray-900 mb-8 text-center">Peki, neden <span class="font-bold">EnUfak?</span></h2>

        <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 md:p-6 mb-8">
            <a href="#"
                class="bg-yellow-100 text-yellow-800 text-xs font-medium inline-flex items-center px-2.5 py-0.5 rounded-md mb-2">
                Verimlilik
            </a>
            <h2 class="text-gray-900 text-2xl md:text-2xl font-extrabold mb-2">Potansiyelini harcama!</h2>
            <p class="text-md font-normal text-gray-500 mb-6">İyi derecede bildiğin fakat bi köşede tuttuğun bilgi ve
                tecrübelerini işe dönüştür. Bi bakmışsın yeni kapılar açmışlar.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 md:p-6">
                <a href="#"
                    class="bg-yellow-100 text-yellow-800 text-xs font-medium inline-flex items-center px-2.5 py-0.5 rounded-md mb-2">
                    Tasarruf
                </a>
                <h2 class="text-gray-900 text-2xl font-extrabold mb-2">Gereksiz vakit kaybetme!</h2>
                <p class="text-md font-normal text-gray-500 mb-4">Yaşadığın sorunla alakalı ordan oraya koşturmana artık
                    gerek yok. Aradığın çözüm sandığından daha yakında.</p>
            </div>

            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 md:p-6">
                <a href="#"
                    class="bg-yellow-100 text-yellow-800 text-xs font-medium inline-flex items-center px-2.5 py-0.5 rounded-md mb-2">
                    İletişim
                </a>
                <h2 class="text-gray-900 text-2xl font-extrabold mb-2">İki taraflı kolay iletişim.</h2>
                <p class="text-md font-normal text-gray-500 mb-4">Platform içerisindeki mesajlaşma özelliği sayesinde
                    daha rahat anlaşabilir ve işi bitirebilirsiniz.</p>
            </div>
        </div>
    </div>
</section>

<section class="py-16 bg-yellow-400" style="padding: 25px;">
    <div class="max-w-screen-xl mx-auto px-4 lg:px-6">
        <div class="mx-auto max-w-screen-md text-center mb-12">
            <h2 class="text-3xl tracking-tight text-gray-800 mb-4">
                EnUfak <span class="font-extrabold ">Topluluk</span>
            </h2>
        </div>
        <br>
        <div class="grid gap-8 lg:grid-cols-3">
            {% for gonderi in gonderiler %}
            <div class="max-w-sm bg-white rounded-lg shadow-sm">
                <a>
                    <img style="height: 200px !important;" class="rounded-t-lg w-full"
                        src="{{gonderi.kapak_resmi.url}}"
                        alt="" />
                </a>
                <div class="p-5">
                    <span
                        class="bg-indigo-100 text-indigo-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded-sm border border-indigo-400">{{gonderi.get_etiket_display}}</span>
                    <a href="/blog/{{gonderi.slug}}/">
                        <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-800">
                            {{gonderi.baslik}}
                        </h5>
                    </a>
                    <span class="text-gray-600 text-sm">{{gonderi.created_at}}</span>
                </div>
            </div>
            {% endfor %}
        </div>

        <br>
        <div class="flex flex-col space-y-4 sm:flex-row sm:justify-center sm:space-y-0">
            <a href="/blog/"
                class="inline-flex justify-center items-center py-3 px-5 text-base font-medium text-center text-gray-700 rounded-lg bg-yellow-400 border border-gray-700">
                Tüm Yazılar
                <svg class="w-3.5 h-3.5 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                    fill="none" viewBox="0 0 14 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M1 5h12m0 0L9 1m4 4L9 9" />
                </svg>
            </a>
        </div>
    </div>
</section>

<section class="bg-white">
    <div class="py-8 px-4 mx-auto max-w-screen-md lg:py-16">
        <div class="mx-auto max-w-screen-md text-center mb-12">
            <h2 class="text-3xl tracking-tight text-gray-800 mb-4">
                Sıkça Sorulan <span class="font-extrabold ">Sorular</span>
            </h2>
        </div>

        <div id="accordion-open" data-accordion="open">
            <h2 id="accordion-open-heading-1">
                <button type="button"
                    class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border border-b-0 border-gray-200 rounded-t-xl gap-3"
                    data-accordion-target="#accordion-open-body-1" aria-expanded="true"
                    aria-controls="accordion-open-body-1">
                    <span class="flex items-center">
                        <svg class="w-5 h-5 me-2 shrink-0" fill="currentColor" viewBox="0 0 20 20"
                            xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd"
                                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
                                clip-rule="evenodd"></path>
                        </svg>
                        EnUfak ne işe yarar?
                    </span>
                    <svg data-accordion-icon class="w-3 h-3 rotate-180 shrink-0" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 5 5 1 1 5" />
                    </svg>
                </button>
            </h2>
            <div id="accordion-open-body-1" class="hidden" aria-labelledby="accordion-open-heading-1">
                <div class="p-5 border border-b-0 border-gray-200">
                    <p class="mb-2 text-gray-500">EnUfak uygulaması, yeteneklerinizi işe dönüştürmenizi veya
                        sorunlarınızı çözecek kişileri hızlı bir şekilde bulabilmenizi amaçlayan bir projedir.</p>
                </div>
            </div>

            <h2 id="accordion-open-heading-2">
                <button type="button"
                    class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border border-b-0 border-gray-200 gap-3"
                    data-accordion-target="#accordion-open-body-2" aria-expanded="false"
                    aria-controls="accordion-open-body-2">
                    <span class="flex items-center">
                        <svg class="w-5 h-5 me-2 shrink-0" fill="currentColor" viewBox="0 0 20 20"
                            xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd"
                                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
                                clip-rule="evenodd"></path>
                        </svg>
                        EnUfak'ı kimler kullanabilir?
                    </span>
                    <svg data-accordion-icon class="w-3 h-3 rotate-180 shrink-0" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 5 5 1 1 5" />
                    </svg>
                </button>
            </h2>
            <div id="accordion-open-body-2" class="hidden" aria-labelledby="accordion-open-heading-2">
                <div class="p-5 border border-b-0 border-gray-200">
                    <p class="mb-2 text-gray-500">EnUfak'ı geliştirirken belli bir kesimi ele almadık. Her kesimden her
                        kişinin kullanabileceği bir platform olup, ilerleyen süreçde de bu şekilde geliştirilmeye devam
                        edilecektir.</p>
                </div>
            </div>

            <h2 id="accordion-open-heading-3">
                <button type="button"
                    class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border border-gray-200 gap-3"
                    data-accordion-target="#accordion-open-body-3" aria-expanded="false"
                    aria-controls="accordion-open-body-3">
                    <span class="flex items-center">
                        <svg class="w-5 h-5 me-2 shrink-0" fill="currentColor" viewBox="0 0 20 20"
                            xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd"
                                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z"
                                clip-rule="evenodd"></path>
                        </svg>
                        Böyle bir uygulama neden var?
                    </span>
                    <svg data-accordion-icon class="w-3 h-3 rotate-180 shrink-0" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 5 5 1 1 5" />
                    </svg>
                </button>
            </h2>
            <div id="accordion-open-body-3" class="hidden" aria-labelledby="accordion-open-heading-3">
                <div class="p-5 border border-t-0 border-gray-200">
                    <p class="mb-2 text-gray-500">
                        "Herkes kendi işini yapabilsin" fikri ile ortaya çıkmıştır. Kenarda köşede duran ve işe
                        çeviremediğiniz bilgileri ihtiyacı olan kişiler ile çalışarak iş haline getirebilirsiniz.
                    </p>
                    <p class="mb-2 text-gray-500">
                        Diğer yandan bakarsak birisine yaptırmanız gereken bir iş var ise, ordan oraya bakıp doğru
                        kişilere ulaşamama sorununa çözüm olarak da bu uygulamayı kullanabilirsiniz.
                    </p>
                </div>
            </div>
        </div>


    </div>
</section>

<section class="bg-white">
    <div class="px-4 mx-auto max-w-screen-md">
        <section class="bg-white py-12 sm:py-16">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-2xl text-center lg:mx-0 lg:text-left">
                    <h2 class="text-3xl tracking-tight text-gray-900 sm:text-4xl">
                    Ekibimizle <span class="font-bold">Tanışın</span>
                    </h2>
                </div>
                <br>
                <div class="mt-16 grid gap-12 sm:grid-cols-2 lg:grid-cols-2">
                    <div class="flex items-center space-x-4">
                        <img class="w-16 h-16 rounded-full shadow"
                            src="https://avatars.githubusercontent.com/u/89014650?s=400&u=4163bd8b43a56758cf577c7b0fb9fd2dfcb9c093&v=4"
                            alt="Ekin İlter Varlı">
                        <div>
                            <h3 class="text-base font-semibold text-gray-900">Ekin İlter VARLI</h3>
                            <p class="text-sm font-medium text-indigo-600">Lead Developer, CTO</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <img class="w-16 h-16 rounded-full shadow"
                            src="{% static 'images/cinar.jpeg' %}"
                            alt="Çınar Yağız Karakuş">
                        <div>
                            <h3 class="text-base font-semibold text-gray-900">Çınar Yağız KARAKUŞ</h3>
                            <p class="text-sm font-medium text-indigo-600">Chief Marketing Officer</p>
                        </div>
                    </div>
                </div><br>
                <a href="/ticket/"
                class="inline-flex justify-center items-center py-3 px-5 text-base font-medium text-center text-white rounded-lg bg-yellow-500 hover:bg-yellow-600 focus:ring-4 focus:ring-blue-300">
                Ekibimize Katıl
                <svg class="w-3.5 h-3.5 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                    fill="none" viewBox="0 0 14 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M1 5h12m0 0L9 1m4 4L9 9" />
                </svg>
            </a>
            </div>
        </section>

    </div>
</section>

{% include 'components/_footer.jinja' %}

{% endblock %}