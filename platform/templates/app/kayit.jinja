{% extends "base.jinja" %}
{% load crispy_forms_tags %}

{% block title %}Kayıt Ol{% endblock %}

{% block content %}
<div class="w-full max-w-md p-8 bg-white rounded-lg shadow-md mt-20 mx-auto">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Kayıt Ol</h2>
    <form method="post" class="space-y-4">
        {% csrf_token %}
        {{ form|crispy }}
        <button type="submit" class="w-full bg-yellow-400 text-white py-2 rounded-lg hover:bg-yellow-500 transition-colors">
            Kayıt Ol
        </button>
    </form>
    <p class="mt-4 text-center text-sm text-gray-500">
        Zaten hesabınız var mı? <a href="{% url 'giris_yap' %}" class="text-blue-600 hover:underline">Giriş Yap</a>
    </p>
</div>

{% endblock %}
