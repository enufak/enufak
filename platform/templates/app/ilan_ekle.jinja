{% extends "base.jinja" %}
{% load crispy_forms_tags %}

{% block title %}İlan Oluştur{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto mt-10 bg-white p-8 rounded-2xl shadow-md">
    <a href="/uygulama/profil/" 
   class="inline-flex items-center px-4 py-2 bg-gray-100 text-gray-800 rounded-lg shadow hover:bg-gray-200 transition">
  <i class="bi bi-arrow-left mr-2"></i>
  Geri dön
</a>
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Yeni İlan Oluştur</h2>

    <div class="mt-6 p-4 rounded-lg bg-yellow-50 border border-yellow-200">
        <p class="text-sm text-yellow-800">
            <i class="bi bi-info-circle-fill mr-2"></i>
            Oluşturduğunuz ilanlar önce sistemimiz tarafından onaylanmalıdır. Onay süreci tamamlandıktan sonra ilanınız yayına alınacaktır.
        </p>
    </div>
    <br>
    <form method="post" enctype="multipart/form-data">
        {% csrf_token %}
        {{ form|crispy }}

        <div class="flex justify-end mt-6">
            <a href="{% url 'profil' %}"
               class="px-5 py-2 rounded-lg border text-gray-600 hover:bg-gray-100 transition">
               İptal
            </a>
            <button type="submit"
                    class="ml-3 px-5 py-2 bg-yellow-500 text-white font-medium rounded-lg hover:bg-yellow-600 transition">
                Kaydet
            </button>
        </div>
    </form>
</div>
{% endblock %}
