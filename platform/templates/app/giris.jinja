{% extends "base.jinja" %}
{% load crispy_forms_tags %}

{% block title %}Giriş Yap{% endblock %}

{% block content %}
{% if request.user.is_authenticated %}
<script>
    document.location.href = '/uygulama/'
</script>
{% endif %}

<div class="w-full max-w-md p-8 bg-white rounded-lg shadow-md mt-20 mx-auto">
    <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Giriş Yap</h2>
    <form method="post" class="space-y-4">
        {% csrf_token %}
        {{ form|crispy }}
        <button type="submit" class="w-full bg-yellow-600 text-white py-2 rounded-lg hover:bg-yellow-700 transition-colors">
            Giriş Yap
        </button>
    </form>
    <p class="mt-4 text-center text-sm text-gray-500">
        Hesabınız yok mu? <a href="{% url 'kayit_ol' %}" class="text-yellow-600 hover:underline">Kayıt Ol</a>
    </p>
</div>

{% endblock %}
