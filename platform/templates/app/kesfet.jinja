{% extends 'base.jinja' %}
{% load static %}

{% block title %}Keşfet{% endblock %}

{% block content %}
<section class="relative bg-yellow-500">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>

    <div class="relative py-16 px-6 mx-auto max-w-screen-xl text-center">
        {% if request.user.is_authenticated %}
        {% else %}
        <a href="/uygulama/giris-yap/"
            class="inline-flex justify-between items-center py-1 px-3 pe-4 mb-7 text-sm text-yellow-800 bg-yellow-100/80 rounded-full shadow-md hover:shadow-lg transition">
            <span class="text-xs bg-yellow-700 rounded-full text-white px-4 py-1.5 me-3">Bilgilendirme</span>
            <span class="text-sm font-medium">Uygulamayı kullanabilmek için giriş yapmalısın.</span>
            <svg class="w-2.5 h-2.5 ms-2 rtl:rotate-180" xmlns="http://www.w3.org/2000/svg" fill="none"
                viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="m1 9 4-4-4-4" />
            </svg>
        </a>
        {% endif %}

        <h1 class="mb-4 text-4xl md:text-5xl lg:text-6xl font-extrabold text-white drop-shadow">
            Neye <span class="underline decoration-yellow-200">ihtiyacın</span> var?
        </h1>
        <p class="mb-10 text-lg font-medium text-yellow-100 max-w-2xl mx-auto">
            İhtiyacın olanı bulmana sandığından daha yakınsın.
        </p>

        <div class="w-full max-w-md mx-auto mt-6">
        <form method="get" action="{% url 'ilan_ara' %}" class="flex items-center bg-white rounded-lg shadow-md overflow-hidden">
            <input type="text" name="kelime"
            class="w-full p-3 text-gray-700 focus:outline-none"
            placeholder="Ne arıyorsunuz?" />
            <button type="button" data-modal-target="filtreModal" data-modal-toggle="filtreModal"
            class="px-4 text-yellow-600 hover:text-yellow-700">
            <i class="bi bi-funnel"></i>
            </button>
            <button type="submit"
            class="bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-4">
            Ara
            </button>
        </form>
        </div>

        <div id="filtreModal" tabindex="-1" aria-hidden="true"
        class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
        <div class="bg-white rounded-lg p-6 w-full max-w-sm">
            <h3 class="text-lg font-semibold mb-4">Filtreler</h3>

            <form method="get" action="{% url 'ilan_ara' %}">
            <label class="block text-sm font-medium">Konum</label>
            <input type="text" name="konum" class="w-full p-2 border rounded mb-3">

            <label class="block text-sm font-medium">Min Ücret</label>
            <input type="number" name="min_ucret" class="w-full p-2 border rounded mb-3">

            <label class="block text-sm font-medium">Max Ücret</label>
            <input type="number" name="max_ucret" class="w-full p-2 border rounded mb-3">

            <div class="flex justify-end space-x-2 mt-4">
                <button data-modal-hide="filtreModal" type="button"
                class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300">
                Vazgeç
                </button>
                <button type="submit" class="px-4 py-2 bg-yellow-600 text-white rounded hover:bg-yellow-700">
                Uygula
                </button>
            </div>
            </form>
        </div>
        </div>



    </div>
</section>

<section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {% if request.user.is_authenticated %}
        <div class="mx-auto max-w-2xl lg:mx-0">
            <h2 class="text-2xl tracking-tight text-gray-900 sm:text-3xl">
                <span>Hoşgeldin, </span>
                <span class="font-bold">{{ request.user.first_name }}</span>
            </h2>
            <p class="mt-2 text-md text-gray-600">En son yayınlanan ilanlara göz at.</p>
        </div><br>
        {% endif %}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

            {% if ilanlar %}
            {% for ilan in ilanlar %}
            <div class="bg-white rounded-lg shadow p-6 flex flex-col hover:shadow-lg transition-shadow duration-300">

                <div class="flex items-center gap-4 mb-4">
                    <img class="w-12 h-12 rounded-full"
                        src="{% if ilan.ilan_sahibi.avatar %}{{ilan.ilan_sahibi.avatar.url}}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}"
                        alt="">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">{{ilan.ilan_sahibi}}</h3>
                    </div>
                </div>

                <h4 class="text-md font-semibold text-gray-800 mb-2">{{ilan.ilan_baslik}}</h4>
                <p class="text-gray-700 text-sm mb-4">
                    {{ilan.ilan_metni|truncatechars:250}}
                </p>

                <div class="flex items-center text-sm text-gray-500 gap-4 mb-4">
                    <div class="flex items-center gap-1">
                        <i class="bi bi-geo-alt-fill"></i>
                        <span>{{ilan.konum}}</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <i class="bi bi-briefcase-fill"></i>
                        <span>{{ilan.is_deneyimi}}</span>
                    </div>
                </div>

                <div class="mt-auto flex justify-between items-center">
                    <span class="text-lg font-bold text-gray-900">İstenilen ücret: <span
                            class="text-green-500">{{ilan.istenilen_ucret}} ₺</span></span>
                    <a href="#"
                        class="text-white bg-yellow-500 hover:bg-yellow-600 px-3 py-1 rounded-lg text-sm">Profili
                        incele</a>
                </div>

            </div>
            {% endfor %}
            {% else %}
            Hiç ilan bulunamadı.
            {% endif %}
        </div>
    </div>
</section>

<section class="bg-gray-50 py-12">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-2xl text-gray-800 mb-4">Alıcı Talebi <span class="font-bold">Oluştur</span></h2>
    
    <p class="text-gray-600 mb-8">
      İhtiyacını topluluğumuzda duyur. Alıcı talebi oluşturarak alanında yetenekli insanların sana ulaşmasını sağla.
    </p>
    
    <a href=""
       class="inline-block px-6 py-3 bg-yellow-600 text-white font-medium rounded-lg shadow-md hover:bg-yellow-700 transition">
      Alıcı Talebi Oluştur
    </a>
  </div>
</section>

{% include 'components/_footer.jinja' %}


{% endblock %}