{% extends "base.jinja" %}
{% load static %}

{% block title %}İlan Ara{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 py-8">

  <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
    <h2 class="text-2xl font-bold text-gray-800">İlanlar</h2>
    <form method="get" action="{% url 'ilan_ara' %}" class="flex mt-4 md:mt-0">
      <div class="relative w-full md:w-80">
        <input type="text" name="kelime" value="{{ kelime }}"
          class="block w-full p-3 ps-10 text-sm border border-gray-300 rounded-lg focus:ring-yellow-600 focus:border-yellow-600"
          placeholder="Anahtar kelime ile ara..." />
      </div>
      <button type="submit"
        class="ml-2 px-5 py-2 bg-yellow-600 hover:bg-yellow-700 text-white font-medium rounded-lg transition">
        Ara
      </button>
    </form>
  </div>

  <div class="bg-white border rounded-lg shadow-sm p-4 mb-8">
    <form method="get" action="{% url 'ilan_ara' %}" class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label for="konum" class="block text-sm font-medium text-gray-700 mb-1">Konum</label>
        <input type="text" id="konum" name="konum" value="{{ konum }}"
          class="w-full p-2 border rounded-lg focus:ring-yellow-600 focus:border-yellow-600">
      </div>
      <div>
        <label for="min_ucret" class="block text-sm font-medium text-gray-700 mb-1">Min. Ücret</label>
        <input type="number" id="min_ucret" name="min_ucret" value="{{ min_ucret }}"
          class="w-full p-2 border rounded-lg focus:ring-yellow-600 focus:border-yellow-600">
      </div>
      <div>
        <label for="max_ucret" class="block text-sm font-medium text-gray-700 mb-1">Maks. Ücret</label>
        <input type="number" id="max_ucret" name="max_ucret" value="{{ max_ucret }}"
          class="w-full p-2 border rounded-lg focus:ring-yellow-600 focus:border-yellow-600">
      </div>
      <div class="flex items-end">
        <button type="submit"
          class="w-full bg-yellow-600 hover:bg-yellow-700 text-white py-2 rounded-lg transition">
          Filtrele
        </button>
      </div>
    </form>
  </div>

  {% if ilanlar %}
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {% for ilan in ilanlar %}
        <div class="border rounded-lg p-5 hover:shadow-lg transition bg-white">
          <h3 class="text-lg font-semibold text-gray-800 mb-2">
            {{ ilan.ilan_baslik }}
          </h3>
          <p class="text-gray-600 text-sm line-clamp-3">{{ ilan.ilan_metni }}</p>

          <div class="mt-4 flex items-center justify-between">
            <span class="text-green-600 font-bold">₺{{ ilan.istenilen_ucret }}</span>
            <span class="text-gray-500 text-sm">
              <i class="bi bi-geo-alt"></i> {{ ilan.konum }}
            </span>
          </div>

          <div class="mt-4">
            <a href="/uygulama/@{{ilan.ilan_sahibi.slug}}/"
              class="block text-center py-2 px-4 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition">
              Profili Gör
            </a>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="text-gray-500">Aramanıza uygun ilan bulunamadı.</p>
  {% endif %}
</div>
{% endblock %}
