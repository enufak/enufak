{% extends 'base.jinja' %}
{% load static %}

{% block title %}Mesaj{% endblock %}

{% block content %}
<div class="flex flex-col w-full max-w-3xl mx-auto border border-gray-300 rounded-xl shadow-md overflow-hidden"
     style="height: calc(96vh - 4rem);">
    
    <div class="flex items-center p-4 bg-gray-100 border-b border-gray-300 flex-shrink-0">
        <img src="{% if other_user.avatar %}{{ other_user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
             alt="Profil" class="w-10 h-10 rounded-full object-cover mr-3">
        <span class="font-semibold"><a href="/uygulama/@{{other_user.slug}}">{{ other_user.get_full_name }}</a></span>
    </div>

    <div id="messages" class="flex-1 p-4 overflow-y-auto bg-white">
        
    </div>

    <form method="post" class="flex p-4 bg-gray-50 border-t border-gray-300 flex-shrink-0">
        {% csrf_token %}
        <input type="text" name="text" placeholder="Mesaj yaz..." 
               class="flex-1 p-2 border border-gray-300 rounded-md mr-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">Gönder</button>
    </form>
</div>

{% endblock %}
{% block scripts %}
<script>
const dmId = {{ dm.id }};
const messagesContainer = document.getElementById('messages');
let lastId = 0;

function fetchMessages() {
    fetch(`/mesajlar/${dmId}/messages-long/?last_id=${lastId}`)
        .then(res => res.json())
        .then(data => {
            if (data.length) {
                data.forEach(msg => {
                    const div = document.createElement('div');
                    div.classList.add('my-2', 'flex');
                    if (msg.sender === '{{ request.user.get_full_name }}') {
                        div.classList.add('justify-end');
                        div.innerHTML = `<div class="bg-indigo-600 text-white px-4 py-2 rounded-xl rounded-br-none max-w-xs break-words">${msg.text}</div>`;
                    } else {
                        div.classList.add('justify-start');
                        div.innerHTML = `<div class="bg-gray-200 text-gray-800 px-4 py-2 rounded-xl rounded-bl-none max-w-xs break-words">${msg.text}</div>`;
                    }
                    messagesContainer.appendChild(div);
                    lastId = msg.id;
                });
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }
            fetchMessages();
        })
        .catch(err => {
            console.error(err);
            setTimeout(fetchMessages, 2000);
        });
}

fetchMessages();

const form = document.querySelector('form');
form.addEventListener('submit', e => {
    e.preventDefault();
    const input = form.querySelector('input[name="text"]');
    const text = input.value.trim();
    if (!text) return;

    fetch(`/mesajlar/${dmId}/send/`, {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'X-CSRFToken': '{{ csrf_token }}'},
        body: JSON.stringify({text})
    }).then(res => res.json())
      .then(data => {
          input.value = '';
      });
});
</script>


{% endblock %}