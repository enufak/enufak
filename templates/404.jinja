{% extends 'base.jinja' %}
{% load static %}

{% block title %}Sayfa Bulunamadı{% endblock %}

{% block content %}
<style>
    @keyframes float {
        0% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-15px);
        }

        100% {
            transform: translateY(0px);
        }
    }

    .floating {
        animation: float 5s ease-in-out infinite;
    }

    .bg-gradient-404 {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .btn-hover-effect {
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .btn-hover-effect:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
    }
</style>

<div class="bg-gradient-404 min-h-screen flex items-center justify-center p-4 relative">
    <div class="max-w-4xl mx-auto text-center text-white relative z-10">
        <!-- İllüstrasyon -->
        <div class="floating mb-8">
            <svg class="w-72 h-72 mx-auto" viewBox="0 0 500 500" xmlns="http://www.w3.org/2000/svg">
                <circle cx="250" cy="250" r="200" fill="#fff" opacity="0.05" />
                <circle cx="250" cy="250" r="150" fill="#fff" opacity="0.08" />
                <defs>
                    <linearGradient id="grad404" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#facc15" stop-opacity="1" />
                        <stop offset="100%" stop-color="#f59e0b" stop-opacity="1" />
                    </linearGradient>
                </defs>
                <text x="250" y="250" text-anchor="middle" dominant-baseline="middle"
                    font-family="Arial Black, sans-serif" font-size="110" fill="url(#grad404)" stroke="#ffffff"
                    stroke-width="3" paint-order="stroke">
                    404
                </text>
            </svg>
        </div>

        <!-- Başlık ve Açıklama -->
        <h1 class="text-5xl md:text-6xl font-bold mb-6">Sayfa Bulunamadı</h1>
        <p class="text-xl md:text-2xl mb-8 opacity-90 max-w-2xl mx-auto">
            Aradığınız sayfa taşınmış, silinmiş veya adı değiştirilmiş olabilir.
            Doğru sayfada olduğunuzdan emin olun ve tekrar deneyin.
        </p>

        <!-- İşlem Butonları -->
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-12">
            <a href="/"
                class="btn-hover-effect bg-white text-purple-700 font-semibold py-3 px-8 rounded-full inline-flex items-center justify-center">
                <i class="fas fa-home mr-2"></i> Ana Sayfaya Dön
            </a>
            <a href="javascript:history.back()"
                class="btn-hover-effect bg-transparent border-2 border-white text-white font-semibold py-3 px-8 rounded-full inline-flex items-center justify-center">
                <i class="fas fa-arrow-left mr-2"></i> Geri Dön
            </a>
            <a href="/ticket/"
                class="btn-hover-effect bg-yellow-500 text-white font-semibold py-3 px-8 rounded-full inline-flex items-center justify-center">
                <i class="fas fa-headset mr-2"></i> Destek Al
            </a>
        </div>

        <!-- Popüler Sayfalar -->
        <div class="bg-white bg-opacity-10 backdrop-blur-lg rounded-2xl p-6 max-w-2xl mx-auto">
            <h3 class="text-xl font-semibold mb-4">Popüler Sayfalar</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <a href="/uygulama/profil/"
                    class="bg-white bg-opacity-20 hover:bg-opacity-30 p-4 rounded-xl transition flex flex-col items-center">
                    <i class="fas fa-user-circle text-2xl mb-2"></i>
                    <span>Profilim</span>
                </a>
                <a href="/uygulama/kesfet/"
                    class="bg-white bg-opacity-20 hover:bg-opacity-30 p-4 rounded-xl transition flex flex-col items-center">
                    <i class="fas fa-compass text-2xl mb-2"></i>
                    <span>Keşfet</span>
                </a>
                <a href="/sss/"
                    class="bg-white bg-opacity-20 hover:bg-opacity-30 p-4 rounded-xl transition flex flex-col items-center">
                    <i class="fas fa-question-circle text-2xl mb-2"></i>
                    <span>Yardım</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Arkaplan Dekorasyon -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -left-20 -top-20 w-64 h-64 rounded-full bg-white opacity-5"></div>
        <div class="absolute -right-20 -bottom-20 w-64 h-64 rounded-full bg-white opacity-5"></div>
        <div class="absolute left-1/4 top-1/3 w-32 h-32 rounded-full bg-yellow-400 opacity-10"></div>
        <div class="absolute right-1/4 bottom-1/3 w-32 h-32 rounded-full bg-yellow-400 opacity-10"></div>
    </div>
</div>
{% endblock %}