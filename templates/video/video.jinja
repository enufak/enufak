{% extends 'base.jinja' %}

{% block title %}Görüntülü Sohbet{% endblock %}

{% block content %}
<div id="jitsi-container" class="fixed inset-0 flex justify-center items-center w-full h-full bg-gray-900"></div>

<script src="https://jitsi.riot.im/external_api.js"></script>
<script>
const domain = "jitsi.riot.im";
const roomName = "EnUfak Proje Odası";
const options = {
    roomName: roomName,
    parentNode: document.querySelector('#jitsi-container'),
    userInfo: { displayName: "{{ request.user.get_full_name }}" },
    width: '100%',
    height: '100%'
};

const api = new JitsiMeetExternalAPI(domain, options);

api.addEventListener('readyToClose', () => {
    window.location.href = document.referrer || '/mesajlar/';
});
</script>

{% endblock %}
