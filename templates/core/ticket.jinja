{% extends 'base.jinja' %}
{% load static %}
{% load crispy_forms_tags %}

{% block title %}Destek Talebi Oluştur{% endblock %}

{% block content %}
<section class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8">
    <div class="max-w-5xl mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-8">
            <!-- Ana Form -->
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden flex-1">
                <!-- Form Başlık -->
                <div class="bg-yellow-500 px-8 py-6 rounded-t-2xl flex items-center">
                    <div class="h-12 w-12 rounded-lg bg-yellow-400 bg-opacity-20 flex items-center justify-center mr-4">
                        <i class="fas fa-headset text-white text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold text-white">Destek Talebi Oluştur</h1>
                        <p class="text-yellow-100 mt-1">Sorunlarınızı ve fikirlerinizi bizimle paylaşın</p>
                    </div>
                </div>

                <form method="post" class="p-8" enctype="multipart/form-data">
                    {% csrf_token %}

                    <div class="space-y-8">
                        <!-- Talep Türü -->
                        <div class="form-group">
                            <label for="id_tur" class="block text-sm font-medium text-gray-700 mb-3 flex items-center">
                                <i class="fas fa-tag text-yellow-500 mr-2"></i>Talep Türü
                            </label>
                            <div class="mt-1 relative">
                                <div
                                    class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                                    <i class="fas fa-list"></i>
                                </div>
                                {{ form.tur }}
                            </div>
                        </div>

                        <!-- Başlık -->
                        <div class="form-group">
                            <label for="id_baslik"
                                class="block text-sm font-medium text-gray-700 mb-3 flex items-center">
                                <i class="fas fa-heading text-yellow-500 mr-2"></i>Başlık
                            </label>
                            <div class="mt-1 relative">
                                <div
                                    class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                                    <i class="fas fa-pencil-alt text-sm"></i>
                                </div>
                                {{ form.baslik }}
                            </div>
                            <p class="mt-2 text-sm text-gray-500">Talebinizi kısa ve net bir şekilde özetleyin</p>
                        </div>

                        <!-- Konu -->
                        <div class="form-group">
                            <label for="id_konu" class="block text-sm font-medium text-gray-700 mb-3 flex items-center">
                                <i class="fas fa-align-left text-yellow-500 mr-2"></i>Detaylı Açıklama
                            </label>
                            <div class="mt-1">
                                {{ form.konu }}
                            </div>
                            <div class="flex justify-between items-center mt-2">
                                <p class="text-sm text-gray-500">Lütfen detaylı ve açıklayıcı şekilde yazın</p>
                                <span class="text-xs text-gray-400">En az 50 karakter</span>
                            </div>
                        </div>
                    </div>
                    <br>
                    <!-- Sürükle-Bırak Fotoğraf Yükleme -->
                    <div class="form-group">
                        <label class="block text-sm font-medium text-gray-700 mb-3 flex items-center">
                            <i class="fas fa-images text-yellow-500 mr-2"></i>Fotoğraf Ekle (Opsiyonel)
                        </label>
                        
                        <div id="drop-zone" 
                             class="mt-1 flex flex-col items-center justify-center px-6 py-8 border-2 border-dashed border-gray-300 rounded-2xl hover:border-yellow-400 transition-colors cursor-pointer bg-gray-50 hover:bg-gray-100">
                            <input type="file" id="id_resim" name="resim" class="hidden" accept="image/*">
                            
                            <div id="upload-icon" class="mb-4">
                                <i class="fas fa-cloud-upload-alt text-4xl text-gray-400"></i>
                            </div>
                            
                            <p class="text-sm text-gray-600 text-center mb-2">
                                <span class="font-medium text-yellow-600">Dosyaları sürükle</span> veya
                                <span class="font-medium text-yellow-600">tıklayarak seç</span>
                            </p>
                            
                            <p class="text-xs text-gray-500 text-center">
                                PNG, JPG, JPEG dosyaları (Maks. 5MB)
                            </p>
                            
                            <div id="file-info" class="mt-4 text-sm text-gray-600 hidden"></div>
                        </div>
                        
                        <!-- Önizleme Alanı -->
                        <div id="preview-container" class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-4 hidden">
                            <div class="relative">
                                <img id="resim-preview" class="w-full h-32 object-cover rounded-lg shadow-md" />
                                <button type="button" id="remove-image" 
                                        class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs shadow-md hover:bg-red-600 transition">
                                    ✕
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Butonlar -->
                    <div class="mt-10 flex items-center justify-between pt-8 border-t border-gray-200">
                        <button type="submit"
                            class="px-6 py-3.5 bg-yellow-500 hover:bg-yellow-600 text-white font-medium rounded-xl shadow-lg transition flex items-center">
                            <i class="fas fa-paper-plane mr-2"></i>Gönder
                        </button>
                    </div>
                </form>
            </div>

            <!-- Yardım ve İpuçları -->
            <div class="lg:w-96 space-y-6">
                <!-- Yardım Kutusu -->
                <div class="bg-white rounded-2xl shadow-xl p-6">
                    <h3 class="text-lg font-semibold text-gray-800 flex items-center mb-4">
                        <i class="fas fa-lightbulb text-yellow-500 mr-2"></i>Destek Talebi İpuçları
                    </h3>
                    <ul class="space-y-3">
                        <li class="flex items-start">
                            <div class="h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center mr-3 mt-0.5">
                                <i class="fas fa-check text-blue-500 text-xs"></i>
                            </div>
                            <span class="text-sm text-gray-600">Başlık kısa, açıklayıcı ve anlaşılır olsun</span>
                        </li>
                        <li class="flex items-start">
                            <div class="h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center mr-3 mt-0.5">
                                <i class="fas fa-check text-blue-500 text-xs"></i>
                            </div>
                            <span class="text-sm text-gray-600">Probleminizi mümkün olduğunca detaylı anlatın</span>
                        </li>
                        <li class="flex items-start">
                            <div class="h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center mr-3 mt-0.5">
                                <i class="fas fa-check text-blue-500 text-xs"></i>
                            </div>
                            <span class="text-sm text-gray-600">Talep türünü doğru seçmeye özen gösterin</span>
                        </li>
                    </ul>
                </div>

                {% if request.user.tc_verified %}
                {% else %}
                <div class="bg-white rounded-2xl shadow-xl p-6">
                    <h3 class="text-lg font-semibold text-gray-800 flex items-center mb-4">
                        <i class="fas fa-id-card text-yellow-500 mr-2"></i>Kimlik Doğrulama Adımları
                    </h3>
                    <ul class="space-y-3">
                        <li class="flex items-start">
                            <div class="h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center mr-3 mt-0.5">
                                <i class="fas fa-check text-blue-500 text-xs"></i>
                            </div>
                            <span class="text-sm text-gray-600">NOT: Bu işlem isteğe bağlıdır.</span>
                        </li>
                        <li class="flex items-start">
                            <div class="h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center mr-3 mt-0.5">
                                <i class="fas fa-check text-blue-500 text-xs"></i>
                            </div>
                            <span class="text-sm text-gray-600">Talep türünü "Kimlik Doğrulaması" olarak seçin.</span>
                        </li>
                        <li class="flex items-start">
                            <div class="h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center mr-3 mt-0.5">
                                <i class="fas fa-check text-blue-500 text-xs"></i>
                            </div>
                            <span class="text-sm text-gray-600">Gerekli alanları doldurun, kimlik 
                            <br>kartınızın ön yüzünün resmini <br>
                            "Fotoğraf Ekle" bölümünden ekleyin.</span>
                        </li>
                        <li class="flex items-start">
                            <div class="h-6 w-6 rounded-full bg-blue-100 flex items-center justify-center mr-3 mt-0.5">
                                <i class="fas fa-check text-blue-500 text-xs"></i>
                            </div>
                            <span class="text-sm text-gray-600">Hesabınızın yöneticiler tarafından <br> onaylanmasını bekleyin.</span>
                        </li>
                    </ul>
                </div>
                {% endif %}

                <!-- Hızlı Yardım -->
                <div class="bg-amber-500 rounded-2xl shadow-xl p-6">
                    <h3 class="text-lg font-semibold text-gray-50 flex items-center mb-4">
                        <i class="fas fa-question-circle text-white mr-2"></i>Hızlı Yardım
                    </h3>
                    <p class="text-sm text-gray-50 mb-4">Sıkça sorulan sorulara göz atın</p>
                    <div class="space-y-2">
                        <a href="/sss/"
                            class="flex items-center justify-between p-3 border text-gray-50 text-sm rounded rounded-lg hover:bg-amber-600 hover:text-gray-50 transition">
                            Hesap ayarlarımı nasıl değiştiririm?
                            <i class="fas fa-chevron-right text-gray-400 text-xs"></i>
                        </a>
                        <a href="/sss/"
                            class="flex items-center justify-between border rounded text-gray-50 hover:text-gray-50 text-sm p-3 rounded-lg hover:bg-amber-600 transition">
                            Şifremi unuttum ne yapmalıyım?
                            <i class="fas fa-chevron-right text-gray-400 text-xs"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .form-group select,
    .form-group input,
    .form-group textarea {
        width: 100%;
        padding: 0.875rem 1rem 0.875rem 3rem;
        border-radius: 0.75rem;
        border: 1px solid #E5E7EB;
        transition: all 0.3s;
        font-size: 0.95rem;
    }

    .form-group select:focus,
    .form-group input:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #EAB308;
        box-shadow: 0 0 0 3px rgba(234, 179, 8, 0.15);
    }

    .form-group select {
        appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        background-size: 1em;
    }

    #drop-zone.drag-over {
        border-color: #EAB308;
        background-color: #FEFCE8;
    }

    #drop-zone.has-file {
        border-color: #10B981;
        background-color: #ECFDF5;
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('id_resim');
    const fileInfo = document.getElementById('file-info');
    const previewContainer = document.getElementById('preview-container');
    const previewImage = document.getElementById('resim-preview');
    const removeButton = document.getElementById('remove-image');
    const uploadIcon = document.getElementById('upload-icon');

    // Tıklama ile dosya seçme
    dropZone.addEventListener('click', function() {
        fileInput.click();
    });

    // Sürükle-bırak olayları
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, highlight, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, unhighlight, false);
    });

    function highlight() {
        dropZone.classList.add('drag-over');
    }

    function unhighlight() {
        dropZone.classList.remove('drag-over');
    }

    // Dosya bırakma
    dropZone.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;
        
        if (files.length > 0) {
            handleFiles(files);
        }
    }

    // Dosya input değiştiğinde
    fileInput.addEventListener('change', function() {
        if (this.files.length > 0) {
            handleFiles(this.files);
        }
    });

    // Dosya işleme
    function handleFiles(files) {
        const file = files[0];
        
        // Dosya tipi kontrolü
        if (!file.type.match('image.*')) {
            alert('Lütfen sadece resim dosyaları yükleyin.');
            return;
        }
        
        // Dosya boyutu kontrolü (max 5MB)
        if (file.size > 5 * 1024 * 1024) {
            alert('Dosya boyutu 5MB\'dan küçük olmalıdır.');
            return;
        }
        
        // Dosya bilgilerini göster
        fileInfo.textContent = `Seçilen dosya: ${file.name} (${formatFileSize(file.size)})`;
        fileInfo.classList.remove('hidden');
        
        // Drop zone stilini güncelle
        dropZone.classList.add('has-file');
        uploadIcon.innerHTML = '<i class="fas fa-check-circle text-4xl text-green-500"></i>';
        
        // Önizleme göster
        const reader = new FileReader();
        reader.onload = function(e) {
            previewImage.src = e.target.result;
            previewContainer.classList.remove('hidden');
        };
        reader.readAsDataURL(file);
    }

    // Dosya boyutunu formatlama
    function formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    // Resmi kaldırma
    removeButton.addEventListener('click', function() {
        fileInput.value = '';
        fileInfo.classList.add('hidden');
        previewContainer.classList.add('hidden');
        dropZone.classList.remove('has-file');
        uploadIcon.innerHTML = '<i class="fas fa-cloud-upload-alt text-4xl text-gray-400"></i>';
    });
});
</script>

{% endblock %}