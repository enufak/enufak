{% extends "base.jinja" %}
{% load static %}

{% block title %}İşleri çözmenin en kolay yolu.{% endblock %}

{% block content %}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        scroll-behavior: smooth;
    }
    
    .hero-gradient {
        background: linear-gradient(135deg, #fefce8 0%, #fffbeb 30%, #fef3c7 70%, #fde68a 100%);
    }
    
    .card-gradient {
        background: linear-gradient(135deg, #ffffff 0%, #fefce8 100%);
    }
    
    .text-gradient {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .btn-gradient {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        transition: all 0.3s ease;
    }
    
    .btn-gradient:hover {
        background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.4);
    }
    
    .category-icon {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        margin-bottom: 16px;
        font-size: 28px;
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        color: #d97706;
        box-shadow: 0 4px 6px rgba(245, 158, 11, 0.1);
    }
    
    .floating {
        animation: floating 6s ease-in-out infinite;
    }
    
    @keyframes floating {
        0% { transform: translate(0, 0px); }
        50% { transform: translate(0, -15px); }
        100% { transform: translate(0, 0px); }
    }
    
    .stats-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
    }
    
    .service-card {
        transition: all 0.3s ease;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.04);
    }
    
    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    
    .testimonial-card {
        background: linear-gradient(135deg, #ffffff 0%, #fefce8 100%);
        border-radius: 16px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.04);
    }
    
    .section-title {
        position: relative;
        display: inline-block;
    }
    
    .section-title:after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 0;
        width: 50%;
        height: 4px;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        border-radius: 2px;
    }
    
    .nav-link {
        position: relative;
        padding: 0.5rem 0;
        font-weight: 500;
        color: #4B5563;
        transition: all 0.3s;
    }
    
    .nav-link:after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        transition: width 0.3s;
    }
    
    .nav-link:hover:after {
        width: 100%;
    }
    
    .nav-link:hover {
        color: #1F2937;
    }
</style>

<body class="bg-gray-50">
    <!-- Hero Section -->
    <section class="hero-gradient pt-16 pb-24 overflow-hidden">
    <div class="container mx-auto px-4 max-w-6xl">
        <div class="flex flex-col md:flex-row items-center">
            <!-- Sol kısım: metin ve butonlar -->
            <div class="md:w-1/2 mb-10 md:mb-0">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-800 mb-6 leading-tight">
                    İşleri çözmenin <span class="text-gradient">en kolay</span> yolu.
                </h1>
                <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                    İşlerin büyüklüğüne bakılmaz, çözüm anında gelir. EnUfak ile becerilerinizi bir işe dönüştürebilir,
                    karşılaştığınız sorunları alanına hakim kişiler yardımıyla çözebilirsiniz.
                </p>
                <div class="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4">
                    <a href="/uygulama/"
                       class="btn-gradient text-white font-medium py-3 px-8 rounded-lg text-center text-lg">
                        Hemen Başla <i class="fas fa-arrow-right ml-2"></i>
                    </a>
                    <a href="#nasil-calisir"
                       class="bg-white text-gray-800 border border-gray-200 font-medium py-3 px-8 rounded-lg text-center text-lg hover:bg-gray-50 transition">
                        Nasıl Çalışır? <i class="fas fa-question-circle ml-2"></i>
                    </a>
                </div>
                
                <div class="mt-10 flex items-center space-x-6">
                    <div class="flex -space-x-3">
                        <img class="w-10 h-10 rounded-full border-2 border-white shadow" src="{% static 'images/blank-profile.jpg' %}">
                        <img class="w-10 h-10 rounded-full border-2 border-white shadow" src="{% static 'images/cinar.jpeg' %}">
                        <img class="w-10 h-10 rounded-full border-2 border-white shadow" src="https://avatars.githubusercontent.com/u/89014650?s=400&u=73c539edff57f9b0f6a292d93b4fd6243a3c3613&v=4" alt="User">
                    </div>
                    <div>
                        <p class="text-sm text-gray-600"><span class="font-semibold text-amber-700">100+</span> mutlu kullanıcı</p>
                        <div class="flex text-amber-400 text-sm">
                            <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="md:w-1/2 relative flex justify-center hidden md:flex">
                <!-- Hero illustration -->
                <img src="{% static 'images/mainbgnew.png' %}"
                    class="max-w-sm md:max-w-md lg:max-w-lg z-10 transform hover:scale-105 transition duration-500" 
                    alt="Illustration">
            </div>

        </div>
    </div>
</section>


    <!-- Popüler Hizmetler -->
    <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4 section-title">Popüler <span class="text-gradient">Hizmetler</span></h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">En çok talep edilen hizmetlerden bazıları</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="card-gradient rounded-xl p-6 shadow-md service-card text-center">
                <div class="category-icon mx-auto" style="background: linear-gradient(135deg, #fde68a 0%, #f59e0b 100%); color: #b45309;">
                    <i class="fas fa-tools"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-800 mb-2">Tamir</h3>
                <p class="text-gray-600 text-sm">Her türlü tamir işleri</p>
            </div>

            <div class="card-gradient rounded-xl p-6 shadow-md service-card text-center">
                <div class="category-icon mx-auto" style="background: linear-gradient(135deg, #fee2e2 0%, #f87171 100%); color: #b91c1c;">
                    <i class="fas fa-heartbeat"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-800 mb-2">Sağlık</h3>
                <p class="text-gray-600 text-sm">Sağlıklı yaşam, spor vb.</p>
            </div>

            <div class="card-gradient rounded-xl p-6 shadow-md service-card text-center">
                <div class="category-icon mx-auto" style="background: linear-gradient(135deg, #dbeafe 0%, #3b82f6 100%); color: #1e40af;">
                    <i class="fas fa-microchip"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-800 mb-2">Teknoloji</h3>
                <p class="text-gray-600 text-sm">Bilgisayar, elektronik ve yazılım hizmetleri</p>
            </div>

            <div class="card-gradient rounded-xl p-6 shadow-md service-card text-center">
                <div class="category-icon mx-auto" style="background: linear-gradient(135deg, #e0f2fe 0%, #60a5fa 100%); color: #1e3a8a;">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-800 mb-2">Eğitim</h3>
                <p class="text-gray-600 text-sm">Kurslar ve eğitim danışmanlığı</p>
            </div>
        </div>

        <div class="text-center mt-10">
            <a href="/uygulama/ara/" class="inline-flex items-center text-amber-600 font-medium hover:text-amber-700">
                Tüm hizmetleri görüntüle <i class="fas fa-arrow-right ml-2"></i>
            </a>
        </div>
    </div>
</section>


    <!-- Nasıl Çalışır? -->
    <section class="py-16 bg-gray-50" id="nasil-calisir">
        <div class="container mx-auto px-4 max-w-6xl">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4 section-title">EnUfak Nasıl <span class="text-gradient">Çalışır</span>?</h2>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">Sadece 3 adımda ihtiyacınız olan hizmeti bulun veya hizmet verin</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
                <div class="text-center">
                    <div class="relative mb-6">
                        <div class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mx-auto shadow-md">
                            <i class="fas fa-tasks text-amber-600 text-2xl"></i>
                        </div>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold shadow">1</div>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-3">İhtiyacını Belirt</h3>
                    <p class="text-gray-600">Yapılmasını istediğin işi detaylı bir şekilde açıkla ve bütçeni belirle.</p>
                </div>

                <div class="text-center">
                    <div class="relative mb-6">
                        <div class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mx-auto shadow-md">
                            <i class="fas fa-handshake text-amber-600 text-2xl"></i>
                        </div>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold shadow">2</div>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-3">Teklifleri Değerlendir</h3>
                    <p class="text-gray-600">Gelen teklifleri inceleyerek sana en uygun olan çalışanı seç.</p>
                </div>

                <div class="text-center">
                    <div class="relative mb-6">
                        <div class="w-20 h-20 bg-amber-100 rounded-full flex items-center justify-center mx-auto shadow-md">
                            <i class="fas fa-rocket text-amber-600 text-2xl"></i>
                        </div>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-amber-500 text-white rounded-full flex items-center justify-center font-bold shadow">3</div>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-800 mb-3">İşe Başla</h3>
                    <p class="text-gray-600">Anlaştığın kişi ile iletişimde kalarak işinin temellerini atmaya hazırsın.</p>
                </div>
            </div>
        </div>
    </section>
 <section class="py-12 bg-white">
    <div class="container mx-auto px-4 md:px-6">
        <div class="bg-yellow-500 rounded-2xl shadow-lg overflow-hidden">
            <div class="md:flex items-center">
                <div class="p-8 md:p-12 md:w-2/3">
                    <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Alıcı Talebi <span
                            class="text-yellow-900">Oluştur</span></h2>
                    <p class="text-yellow-100 mb-6 max-w-md">
                        İhtiyacını topluluğumuzda duyur. Alıcı talebi oluşturarak alanında yetenekli insanların sana
                        ulaşmasını sağla.
                    </p>
                    <a href="/uygulama/alici-talebi-olustur/"
                        class="inline-flex items-center px-5 py-3 bg-white text-yellow-700 font-medium rounded-lg shadow-md hover:bg-gray-50 transition">
                        <i class="fas fa-plus-circle me-2"></i>
                        Alıcı Talebi Oluştur
                    </a>
                </div>
                <div class="hidden md:block md:w-1/3">
                    <div class="relative h-full">
                        <div class="absolute -top-4 -left-4 w-32 h-32 bg-yellow-300 rounded-full opacity-20"></div>
                        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-yellow-200 rounded-full opacity-30"></div>
                        <div class="relative p-6 flex justify-center items-center h-full">
                            <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-4 border border-white/30">
                                <i class="fas fa-bullhorn text-5xl text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

    <!-- CTA Section -->
    <section class="py-16" style="background:linear-gradient(to right, #f59e0b, #d97706);">
        <div class="container mx-auto px-4 max-w-4xl text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">Hemen Üye Ol, İşini Hallet!</h2>
            <p class="text-lg text-white mb-8 opacity-90">Güçlü topluluğumuza katıl ve ihtiyacın olan hizmeti bul veya yeteneklerini paraya dönüştür.</p>
            <div class="flex flex-col sm:flex-row justify-center space-y-4 sm:space-y-0 sm:space-x-4">
                <a href="/uygulama/kayit-ol/"
                    class="bg-white text-amber-600 font-medium py-3 px-8 rounded-lg text-lg hover:bg-gray-100 transition shadow-lg">
                    Ücretsiz Kaydol <i class="fas fa-user-plus ml-2"></i>
                </a>
                <a href="/uygulama/giris-yap/"
                    class="bg-amber-800 text-white font-medium py-3 px-8 rounded-lg text-lg hover:bg-amber-900 transition shadow-lg">
                    Giriş Yap <i class="fas fa-sign-in-alt ml-2"></i>
                </a>
            </div>
        </div>
    </section>

    {% include 'components/_footer.jinja' %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Animasyon için Intersection Observer
            const observerOptions = { root: null, rootMargin: '0px', threshold: 0.1 };
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('animate-fade-in');
                    }
                });
            }, observerOptions);
            
            document.querySelectorAll('.service-card, .category-icon').forEach(card => observer.observe(card));
        });
    </script>

</body>

