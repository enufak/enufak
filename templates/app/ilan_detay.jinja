{% extends 'base.jinja' %}
{% load static %}

{% block title %}{{ilan.ilan_baslik}}{% endblock %}

{% block content %}
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex text-sm" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
            <li>
                <a href="/" class="text-gray-500 hover:text-yellow-500 transition-colors duration-200">Ana Sayfa</a>
            </li>
            <li class="flex items-center">
                <svg class="h-4 w-4 text-gray-400 mx-2" xmlns="http://www.w3.org/2000/svg" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <a href="/uygulama/kesfet/"
                    class="text-gray-500 hover:text-yellow-500 transition-colors duration-200">Keşfet</a>
            </li>
            <li class="flex items-center">
                <svg class="h-4 w-4 text-gray-400 mx-2" xmlns="http://www.w3.org/2000/svg" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span class="text-gray-700 font-medium truncate max-w-xs">{{ilan.ilan_baslik|truncatewords:5}}</span>
            </li>
        </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-6">
            <!-- İlan Detayları Kartı -->
            <div
                class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100 transition-all duration-300 hover:shadow-md">
                <div class="flex flex-col sm:flex-row justify-between items-start gap-4 mb-6">
                    <h1 class="text-3xl font-bold text-gray-900 leading-tight">{{ilan.ilan_baslik}}</h1>
                    <span
                        class="px-4 py-2 bg-yellow-100 text-yellow-800 text-sm font-semibold rounded-full flex-shrink-0">
                        {{ilan.get_kategori_display}}
                    </span>
                </div>

                <div class="flex flex-wrap gap-3 mb-6">
                    <span class="inline-flex items-center px-3 py-1.5 bg-gray-100 text-gray-700 rounded-full text-sm">
                        <i class="fas fa-clock text-yellow-500 mr-1.5 text-xs"></i>
                        {{ilan.created_at|timesince}} önce
                    </span>
                    <span class="inline-flex items-center px-3 py-1.5 bg-gray-100 text-gray-700 rounded-full text-sm">
                        <i class="fas fa-eye text-yellow-500 mr-1.5 text-xs"></i>
                        {{ ilan.goruntulenme_sayisi }} görüntüleme
                    </span>
                </div>

                <div class="mb-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
                        <div class="w-9 h-9 bg-yellow-100 rounded-lg flex items-center justify-center mr-3">
                            <i class="fas fa-file-alt text-yellow-500 text-lg"></i>
                        </div>
                        İlan Detayları
                    </h2>
                    <div class="text-gray-700 leading-relaxed prose prose-yellow max-w-none">
                        {{ilan.ilan_metni|linebreaks}}
                    </div>
                </div>
            </div>

            <!-- Çalışan Hakkında Kartı -->
            <div
                class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100 transition-all duration-300 hover:shadow-md">
                <h2 class="text-xl font-semibold text-gray-900 mb-6 flex items-center">
                    <div class="w-9 h-9 bg-yellow-100 rounded-lg flex items-center justify-center mr-3">
                        <i class="fas fa-user text-yellow-500 text-lg"></i>
                    </div>
                    Çalışan Hakkında
                </h2>

                <div class="flex flex-col sm:flex-row items-start gap-5 mb-6">
                    <div class="relative">
                        <img src="{% if ilan.ilan_sahibi.avatar %}{{ilan.ilan_sahibi.avatar.url}}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}"
                            alt="{{ilan.ilan_sahibi.get_full_name}}"
                            class="w-20 h-20 rounded-xl object-cover border-2 border-yellow-100 shadow-sm">

                        {% if ilan.ilan_sahibi.is_superuser %}
                        <div
                            class="absolute -bottom-1 -right-1 w-6 h-6 bg-red-500 rounded-full flex items-center justify-center shadow-md">
                            <i class="fas fa-crown text-white text-xs"></i>
                        </div>
                        {% elif ilan.ilan_sahibi.onayli_kullanici %}
                        <div
                            class="absolute -bottom-1 -right-1 w-6 h-6 bg-yellow-500 rounded-full flex items-center justify-center shadow-md">
                            <i class="fas fa-check text-white text-xs"></i>
                        </div>
                        {% endif %}
                    </div>

                    <div>
                        <h3 class="font-bold text-lg text-gray-900">{{ilan.ilan_sahibi.get_full_name}}</h3>
                        <div class="flex items-center text-sm text-gray-600">
                            {{ilan.ilan_sahibi.date_joined|date:"d M Y"}} tarihinde üye oldu.
                        </div>
                        <div class="flex items-center mt-2 mb-3">
                            {% if ilan.ilan_sahibi.is_superuser %}
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 bg-red-100 text-red-800 rounded-full text-xs font-medium">
                                <i class="fas fa-crown mr-1 text-xs"></i> Yönetici
                            </span>
                            {% elif ilan.ilan_sahibi.onayli_kullanici %}
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 bg-yellow-100 text-yellow-800 rounded-full text-xs font-medium">
                                <i class="fas fa-check-circle mr-1 text-xs"></i> Doğrulanmış Kullanıcı
                            </span>
                            {% else %}
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 bg-gray-100 text-gray-800 rounded-full text-xs font-medium">
                                Normal Kullanıcı
                            </span>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                    <h4 class="font-medium text-gray-900 mb-2 flex items-center">
                        <i class="fas fa-info-circle text-yellow-500 mr-2 text-sm"></i>
                        Biyografi
                    </h4>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        {{ilan.ilan_sahibi.biyografi|default:"Bu kullanıcı biyografisini henüz doldurmamış."}}
                    </p>
                </div>
            </div>
        </div>

        <!-- Sağ Sidebar -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100 sticky top-6">
                <button id="profil-goruntule" onclick="profilGoruntule('{{ilan.ilan_sahibi.slug}}')"
                    class="w-full bg-yellow-500 hover:bg-yellow-600 text-white py-3.5 rounded-xl font-semibold transition-all duration-300 shadow-md hover:shadow-lg mb-4 flex items-center justify-center transform hover:-translate-y-0.5">
                    <i class="far fa-user mr-2"></i>
                    Profili Görüntüle
                </button>

                <a href="/ticket/"
                    class="w-full border border-yellow-500 text-yellow-500 py-3.5 rounded-xl font-semibold hover:bg-yellow-50 transition-all duration-300 mb-6 flex items-center justify-center">
                    <i class="far fa-flag mr-2"></i>
                    Şikayet Et
                </a>

                <div class="space-y-5 border-t border-gray-200 pt-6">
                    <h3 class="font-semibold text-gray-900 text-lg flex items-center">
                        <i class="fas fa-info-circle text-yellow-500 mr-2 text-lg"></i>
                        İlan Bilgileri
                    </h3>

                    <div
                        class="flex items-center p-3.5 bg-gray-50 rounded-xl border border-gray-100 transition-all duration-300 hover:bg-gray-100/50">
                        <div
                            class="w-11 h-11 bg-yellow-100 rounded-xl flex items-center justify-center mr-3.5 flex-shrink-0">
                            <i class="fas fa-money-bill-wave text-yellow-600 text-lg"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">İstenen Ücret</p>
                            <p class="font-semibold text-gray-900 text-lg">{{ilan.istenilen_ucret}} TL</p>
                        </div>
                    </div>

                    <div
                        class="flex items-center p-3.5 bg-gray-50 rounded-xl border border-gray-100 transition-all duration-300 hover:bg-gray-100/50">
                        <div
                            class="w-11 h-11 bg-yellow-100 rounded-xl flex items-center justify-center mr-3.5 flex-shrink-0">
                            <i class="fas fa-briefcase text-yellow-600 text-lg"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Deneyim</p>
                            <p class="font-semibold text-gray-900 text-lg">{{ilan.is_deneyimi}}</p>
                        </div>
                    </div>

                    <div
                        class="flex items-center p-3.5 bg-gray-50 rounded-xl border border-gray-100 transition-all duration-300 hover:bg-gray-100/50">
                        <div
                            class="w-11 h-11 bg-yellow-100 rounded-xl flex items-center justify-center mr-3.5 flex-shrink-0">
                            <i class="fas fa-map-marker-alt text-yellow-600 text-lg"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Konum</p>
                            <p class="font-semibold text-gray-900 text-lg">{{ilan.konum}}</p>
                        </div>
                    </div>

                    <div
                        class="flex items-center p-3.5 bg-gray-50 rounded-xl border border-gray-100 transition-all duration-300 hover:bg-gray-100/50">
                        <div
                            class="w-11 h-11 bg-yellow-100 rounded-xl flex items-center justify-center mr-3.5 flex-shrink-0">
                            <i class="fas fa-calendar-alt text-yellow-600 text-lg"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Yayınlanma Tarihi</p>
                            <p class="font-semibold text-gray-900 text-lg">{{ilan.created_at|date:"d M Y"}}</p>
                        </div>
                    </div>
                </div>

                <!-- Sosyal Paylaşım Butonları -->
                <div class="mt-6 pt-6 border-t border-gray-200">
                <h3 class="font-semibold text-gray-900 text-lg mb-3 flex items-center">
                    <i class="fas fa-share-alt text-yellow-500 mr-2 text-lg"></i>
                    İlanı Paylaş
                </h3>
                <div class="flex flex-wrap gap-2">
                    <!-- Twitter -->
                    <a target="_blank" href="https://twitter.com/intent/tweet?url={{ request.build_absolute_uri }}" id="twitter-share"
                        class="social-btn relative w-12 h-12 rounded-xl bg-blue-400 text-white flex items-center justify-center hover:bg-blue-500 transition-colors duration-300">
                        <i class="fab fa-twitter text-sm"></i>
                        <div class="tooltip absolute bottom-[-40px] left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs py-1 px-2 rounded-md whitespace-nowrap opacity-0 invisible transition-all duration-300">
                            Twitter'da Paylaş
                        </div>
                    </a>

                    <!-- LinkedIn -->
                    <a target="_blank" href="https://www.linkedin.com/sharing/share-offsite/?url={{ request.build_absolute_uri }}" id="linkedin-share"
                        class="social-btn relative w-12 h-12 rounded-xl bg-blue-800 text-white flex items-center justify-center hover:bg-blue-900 transition-colors duration-300">
                        <i class="fab fa-linkedin-in text-sm"></i>
                        <div class="tooltip absolute bottom-[-40px] left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs py-1 px-2 rounded-md whitespace-nowrap opacity-0 invisible transition-all duration-300">
                            LinkedIn'de Paylaş
                        </div>
                    </a>

                    <!-- WhatsApp -->
                    <a target="_blank" href="https://api.whatsapp.com/send?text={{ request.build_absolute_uri }}" id="whatsapp-share"
                        class="social-btn relative w-12 h-12 rounded-xl bg-green-500 text-white flex items-center justify-center hover:bg-green-600 transition-colors duration-300">
                        <i class="fab fa-whatsapp text-sm"></i>
                        <div class="tooltip absolute bottom-[-40px] left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs py-1 px-2 rounded-md whitespace-nowrap opacity-0 invisible transition-all duration-300">
                            WhatsApp'ta Paylaş
                        </div>
                    </a>

                    <!-- Link Kopyala -->
                    <button id="copy-link-btn"
                        class="social-btn relative w-12 h-12 rounded-xl bg-yellow-500 text-white flex items-center justify-center hover:bg-yellow-600 transition-colors duration-300">
                        <i class="fas fa-link text-sm"></i>
                        <div id="copy-tooltip"
                            class="tooltip absolute bottom-[-40px] left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs py-1 px-2 rounded-md whitespace-nowrap opacity-0 invisible transition-all duration-300">
                            Linki Kopyala
                        </div>
                    </button>
                </div>
            </div>

            </div>

          
        </div>
    </div>
</main>

<script>
    function profilGoruntule(slug) {
        window.location.href = '/uygulama/@' + slug + '/'
    }

    // Daha interaktif bir deneyim için ek JavaScript
    document.addEventListener('DOMContentLoaded', function () {
        // Kartlara hover efekti
        const cards = document.querySelectorAll('.bg-white');
        cards.forEach(card => {
            card.addEventListener('mouseenter', () => {
                card.classList.add('shadow-md');
                card.classList.remove('shadow-sm');
            });
            card.addEventListener('mouseleave', () => {
                card.classList.remove('shadow-md');
                card.classList.add('shadow-sm');
            });
        });

        // Sosyal medya butonlarına tooltip ekleme
        const socialBtns = document.querySelectorAll('.social-btn');
        socialBtns.forEach(btn => {
            btn.addEventListener('mouseenter', function () {
                const tooltip = this.querySelector('.tooltip');
                tooltip.classList.remove('opacity-0', 'invisible');
                tooltip.classList.add('opacity-100', 'visible');
            });

            btn.addEventListener('mouseleave', function () {
                const tooltip = this.querySelector('.tooltip');
                tooltip.classList.remove('opacity-100', 'visible');
                tooltip.classList.add('opacity-0', 'invisible');
            });
        });

        // Link kopyalama işlevi
        document.getElementById('copy-link-btn').addEventListener('click', function () {
            // Geçici bir textarea oluştur ve linki kopyala
            const tempTextArea = document.createElement('textarea');
            tempTextArea.value = window.location.href;
            document.body.appendChild(tempTextArea);
            tempTextArea.select();
            document.execCommand('copy');
            document.body.removeChild(tempTextArea);

            // Tooltip metnini değiştir
            const tooltip = document.getElementById('copy-tooltip');
            tooltip.textContent = 'Link Kopyalandı!';

            // Animasyon ekle
            this.classList.add('copied');

            // 2 saniye sonra orijinal haline döndür
            setTimeout(() => {
                tooltip.textContent = 'Linki Kopyala';
                this.classList.remove('copied');
            }, 2000);
        });
    });
</script>

<style>
    /* Özel stiller */
    .prose-yellow a {
        color: #F59E0B;
        text-decoration: underline;
    }

    .prose-yellow a:hover {
        color: #D97706;
    }

    /* Instagram gradient */
    .instagram-bg {
        background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    }

    .instagram-bg:hover {
        background: linear-gradient(45deg, #e57e1f, #d8532a, #ce1f3b, #be1a5a, #ad1377);
    }

    /* Animasyonlar */
    @keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
        }
    }

    .copied {
        animation: pulse 0.5s ease;
    }

    /* Yumuşak geçişler için */
    .transition-all {
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 300ms;
    }
</style>
{% endblock %}