{% extends 'base.jinja' %}
{% load static %}
{% load crispy_forms_tags %}

{% block title %}Profil Düzenle{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-yellow-50 to-gray-100 py-8 px-4">
  <div class="max-w-4xl mx-auto">
    <!-- Başlık ve Geri Butonu -->
    <div class="flex items-center justify-between mb-8">
      <a href="/uygulama/profil/" 
         class="inline-flex items-center px-4 py-3 bg-white text-gray-800 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        
      </a>
      <h1 class="text-3xl font-bold text-gray-900">Profilini Düzenle</h1>
      <div class="w-40"></div> <!-- Boş alan için -->
    </div>

    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
      <form method="post" enctype="multipart/form-data" class="md:flex">
        {% csrf_token %}
        
        <!-- Sol Taraf - Profil Fotoğrafı -->
        <div class="md:w-1/3 bg-gradient-to-b from-yellow-100 to-yellow-200 p-8 flex flex-col items-center">
          <div class="relative mb-6">
            <div class="w-32 h-32 rounded-full bg-white p-1 shadow-lg">
              {% if user.avatar %}
                <img src="{{ user.avatar.url }}" 
                     class="w-full h-full rounded-full object-cover border-4 border-white" 
                     alt="Profil Fotoğrafı" id="avatar-preview">
              {% else %}
                <img src="{% static 'images/blank-profile.jpg' %}" 
                     class="w-full h-full rounded-full object-cover border-4 border-white" 
                     alt="Profil Fotoğrafı" id="avatar-preview">
              {% endif %}
            </div>
            <label for="id_avatar" class="absolute bottom-0 right-0 bg-yellow-500 text-white p-2 rounded-full shadow-lg cursor-pointer hover:bg-yellow-600 transition">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
              </svg>
              <input type="file" name="avatar" id="id_avatar" class="hidden" accept="image/*">
            </label>
          </div>
          
          <p class="text-sm text-yellow-700 text-center mb-4">
            JPG, PNG veya GIF dosyaları. Maksimum 5MB.
          </p>
          
          <div class="mt-4 p-4 bg-white rounded-lg shadow-sm w-full">
            <h3 class="font-semibold text-gray-800 mb-2 flex items-center">
              <svg class="w-5 h-5 text-yellow-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              İpuçları
            </h3>
            <ul class="text-xs text-gray-600 space-y-1">
              <li>• Gerçek fotoğrafınız kullanıcı deneyimini artırır</li>
              <li>• Net ve aydınlık bir fotoğraf seçin</li>
              <li>• Yüzünüzün göründüğünden emin olun</li>
            </ul>
          </div>
        </div>

        <!-- Sağ Taraf - Form -->
        <div class="md:w-2/3 p-8">
          <!-- Form Alanları -->
          <div class="grid md:grid-cols-2 gap-6">
            {% for field in form %}
              {% if field.name != 'avatar' %}
                <div class="{% if field.name == 'bio' or field.name == 'address' %}md:col-span-2{% endif %}">
                  <label for="{{ field.id_for_label }}" class="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                    {% if field.name == 'first_name' %}
                      <svg class="w-4 h-4 text-yellow-500 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                      </svg>
                    {% elif field.name == 'email' %}
                      <svg class="w-4 h-4 text-yellow-500 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                      </svg>
                    {% elif field.name == 'bio' %}
                      <svg class="w-4 h-4 text-yellow-500 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                    {% endif %}
                    {{ field.label }}
                  </label>
                  {{ field }}
                  {% if field.help_text %}
                    <p class="mt-1 text-sm text-gray-500">{{ field.help_text }}</p>
                  {% endif %}
                  {% for error in field.errors %}
                    <p class="mt-1 text-sm text-red-600">{{ error }}</p>
                  {% endfor %}
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <!-- Kaydet Butonu -->
          <div class="flex justify-end pt-6">
            <button type="submit"
                    class="px-8 py-3 bg-yellow-500 text-white font-medium rounded-lg shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5 flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Değişiklikleri Kaydet
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Özel CSS -->
<style>
  /* Form alanları için özel stil */
  input, textarea, select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    transition: all 0.2s;
  }
  
  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: #eab308;
    box-shadow: 0 0 0 3px rgba(234, 179, 8, 0.1);
  }
  
  /* Avatar yükleme butonu için hover efekti */
  label[for="id_avatar"]:hover {
    transform: scale(1.05);
  }
</style>

<!-- JavaScript for Avatar Preview -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const avatarInput = document.getElementById('id_avatar');
    const avatarPreview = document.getElementById('avatar-preview');
    
    if (avatarInput) {
      avatarInput.addEventListener('change', function() {
        const file = this.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(e) {
            if (avatarPreview) {
              avatarPreview.src = e.target.result;
            }
          }
          reader.readAsDataURL(file);
        }
      });
    }
    
    // Form alanlarına otomatik odaklanma
    const firstInput = document.querySelector('input:not([type="hidden"]):not([type="file"]), textarea, select');
    if (firstInput) {
      firstInput.focus();
    }
  });
</script>
{% endblock %}