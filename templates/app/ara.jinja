{% extends "base.jinja" %}
{% load static %}

{% block title %}İlan Ara{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">İlanlar</h1>
            <p class="text-gray-500 mt-2">Aradığınız işi bulun veya hizmetinizi sunun</p>
        </div>
        <form method="get" action="{% url 'ilan_ara' %}" class="flex mt-6 md:mt-0 w-full md:w-auto">
            <div class="relative flex-grow">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                    </svg>
                </div>
                <input type="text" name="kelime" value="{{ kelime }}"
                    class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-l-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500"
                    placeholder="Anahtar kelime ile ara..." />
            </div>
            <button type="submit"
                class="ml-0 px-5 py-3 bg-yellow-500 hover:bg-yellow-600 text-white font-medium rounded-r-lg transition flex items-center justify-center">
                <span>Ara</span>
            </button>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-sm p-6 mb-8 border border-gray-100">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Detaylı Filtreleme</h3>
        <form method="get" action="{% url 'ilan_ara' %}" class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <div>
                <label for="kategori" class="block text-sm font-medium text-gray-700 mb-2">Kategori</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none z-10">
                        <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <select id="kategori" name="kategori"
                        class="pl-10 block w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 appearance-none bg-white">
                        <option value="">Tüm Kategoriler</option>
                        <option value="teknoloji" {% if kategori == 'teknoloji' %}selected{% endif %}>Teknoloji</option>
                        <option value="sanat" {% if kategori == 'sanat' %}selected{% endif %}>Sanat</option>
                        <option value="tamir" {% if kategori == 'tamir' %}selected{% endif %}>Tamir</option>
                        <option value="eglence" {% if kategori == 'eglence' %}selected{% endif %}>Eğlence</option>
                        <option value="egitim" {% if kategori == 'egitim' %}selected{% endif %}>Eğitim</option>
                        <option value="saglik" {% if kategori == 'saglik' %}selected{% endif %}>Sağlık</option>
                        <option value="moda" {% if kategori == 'moda' %}selected{% endif %}>Moda</option>
                        <option value="diger" {% if kategori == 'diger' %}selected{% endif %}>Diğer</option>
                    </select>
                    
                </div>
            </div>
            <div>
                <label for="konum" class="block text-sm font-medium text-gray-700 mb-2">Konum</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <input type="text" id="konum" name="konum" value="{{ konum }}"
                        class="pl-10 block w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500"
                        placeholder="Şehir veya ilçe">
                </div>
            </div>
            <div>
                <label for="min_ucret" class="block text-sm font-medium text-gray-700 mb-2">Min. Ücret</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-500">₺</span>
                    </div>
                    <input type="number" id="min_ucret" name="min_ucret" value="{{ min_ucret }}"
                        class="pl-7 block w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500"
                        placeholder="En az">
                </div>
            </div>
            <div>
                <label for="max_ucret" class="block text-sm font-medium text-gray-700 mb-2">Maks. Ücret</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-500">₺</span>
                    </div>
                    <input type="number" id="max_ucret" name="max_ucret" value="{{ max_ucret }}"
                        class="pl-7 block w-full p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500"
                        placeholder="En fazla">
                </div>
            </div>

            <!-- Onaylı Kullanıcı -->
        <div class="flex items-center mt-6">
            <input type="checkbox" id="onayli" name="onayli" value="1" 
                   {% if request.GET.onayli %}checked{% endif %}
                   class="h-4 w-4 text-yellow-500 border-gray-300 rounded focus:ring-yellow-500">
            <label for="onayli" class="ml-2 block text-sm text-gray-700">Onaylı Kullanıcılar</label>
        </div>

        <!-- Çevrim içi Kullanıcı -->
        <div class="flex items-center mt-6">
            <input type="checkbox" id="cevrimici" name="cevrimici" value="1" 
                   {% if request.GET.cevrimici %}checked{% endif %}
                   class="h-4 w-4 text-yellow-500 border-gray-300 rounded focus:ring-yellow-500">
            <label for="cevrimici" class="ml-2 block text-sm text-gray-700">Çevrim İçi Kullanıcılar</label>
        </div>
            <div class="flex items-end">
                <button type="submit"
                    class="w-full bg-yellow-500 hover:bg-yellow-600 text-white py-2.5 px-4 rounded-lg transition font-medium flex items-center justify-center">
                    <svg class="h-5 w-5 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd" />
                    </svg>
                    Filtrele
                </button>
            </div>


        </form>
    </div>

    <!-- Aktif Filtreler -->
    {% if kelime or konum or min_ucret or max_ucret or kategori %}
    <div class="bg-yellow-50 rounded-xl p-4 mb-6 border border-yellow-200">
        <div class="flex flex-wrap items-center gap-2">
            <span class="text-sm font-medium text-gray-700">Aktif Filtreler:</span>
            
            {% if kelime %}
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                Kelime: {{ kelime }}
                <a href="?{% if konum %}konum={{ konum }}&{% endif %}{% if min_ucret %}min_ucret={{ min_ucret }}&{% endif %}{% if max_ucret %}max_ucret={{ max_ucret }}&{% endif %}{% if kategori %}kategori={{ kategori }}&{% endif %}" class="ml-1 text-yellow-600 hover:text-yellow-800">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </a>
            </span>
            {% endif %}
            
            {% if kategori and kategori != "" %}
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                Kategori: {{ kategori|title }}
                <a href="?{% if kelime %}kelime={{ kelime }}&{% endif %}{% if konum %}konum={{ konum }}&{% endif %}{% if min_ucret %}min_ucret={{ min_ucret }}&{% endif %}{% if max_ucret %}max_ucret={{ max_ucret }}&{% endif %}" class="ml-1 text-yellow-600 hover:text-yellow-800">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </a>
            </span>
            {% endif %}
            
            {% if konum %}
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                Konum: {{ konum }}
                <a href="?{% if kelime %}kelime={{ kelime }}&{% endif %}{% if min_ucret %}min_ucret={{ min_ucret }}&{% endif %}{% if max_ucret %}max_ucret={{ max_ucret }}&{% endif %}{% if kategori %}kategori={{ kategori }}&{% endif %}" class="ml-1 text-yellow-600 hover:text-yellow-800">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </a>
            </span>
            {% endif %}
            
            {% if min_ucret %}
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                Min: {{ min_ucret }}₺
                <a href="?{% if kelime %}kelime={{ kelime }}&{% endif %}{% if konum %}konum={{ konum }}&{% endif %}{% if max_ucret %}max_ucret={{ max_ucret }}&{% endif %}{% if kategori %}kategori={{ kategori }}&{% endif %}" class="ml-1 text-yellow-600 hover:text-yellow-800">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </a>
            </span>
            {% endif %}
            
            {% if max_ucret %}
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                Maks: {{ max_ucret }}₺
                <a href="?{% if kelime %}kelime={{ kelime }}&{% endif %}{% if konum %}konum={{ konum }}&{% endif %}{% if min_ucret %}min_ucret={{ min_ucret }}&{% endif %}{% if kategori %}kategori={{ kategori }}&{% endif %}" class="ml-1 text-yellow-600 hover:text-yellow-800">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </a>
            </span>
            {% endif %}
            
            <a href="{% url 'ilan_ara' %}" class="ml-auto text-sm text-yellow-600 hover:text-yellow-800 font-medium">
                Tüm Filtreleri Temizle
            </a>
        </div>
    </div>
    {% endif %}

    {% if ilanlar %}
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {% for ilan in ilanlar %}
        <div class="bg-white rounded-2xl shadow-sm p-6 flex flex-col hover:shadow-md transition-all duration-300 border border-gray-100 group">
            <!-- Kategori Badge -->
            {% if ilan.kategori %}
            <div class="mb-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                    {% if ilan.kategori == 'teknoloji' %}bg-blue-100 text-blue-800
                    {% elif ilan.kategori == 'sanat' %}bg-purple-100 text-purple-800
                    {% elif ilan.kategori == 'tamir' %}bg-green-100 text-green-800
                    {% elif ilan.kategori == 'eglence' %}bg-pink-100 text-pink-800
                    {% elif ilan.kategori == 'egitim' %}bg-indigo-100 text-indigo-800
                    {% elif ilan.kategori == 'saglik' %}bg-red-100 text-red-800
                    {% elif ilan.kategori == 'moda' %}bg-yellow-100 text-yellow-800
                    {% else %}bg-gray-100 text-gray-800{% endif %}">
                    {{ ilan.get_kategori_display }}
                </span>
            </div>
            {% endif %}
            
            <div class="flex items-center gap-4 mb-4">
                <div class="relative">
                    <img class="w-12 h-12 rounded-full object-cover border-2 border-white shadow"
                        src="{% if ilan.ilan_sahibi.avatar %}{{ ilan.ilan_sahibi.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}"
                        alt="{{ ilan.ilan_sahibi }}">
                    {% if ilan.ilan_sahibi.is_online %}
                    <span
                        class="absolute -bottom-1 -right-1 bg-green-400 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">
                    </span>
                    {% endif %}
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-gray-900">
                        <a href="/uygulama/@{{ilan.ilan_sahibi.slug}}/">{{ ilan.ilan_sahibi.get_full_name|default:ilan.ilan_sahibi }}</a></h3>
                    {% if ilan.ilan_sahibi.is_superuser %}
                    <div class="flex items-center text-xs text-gray-500">
                        <i class="fas fa-check-circle text-red-500 me-1"></i>
                        <span>Yönetici</span>
                    </div>
                    {% elif ilan.ilan_sahibi.onayli_kullanici %}
                    <div class="flex items-center text-xs text-gray-500">
                        <i class="fas fa-check-circle text-yellow-500 me-1"></i>
                        <span>Doğrulanmış Kullanıcı</span>
                    </div>
                    {% endif%}
                </div>
            </div>

            <h4 class="text-lg font-bold text-gray-800 mb-2 line-clamp-1">{{ ilan.ilan_baslik }}</h4>
            <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                {{ ilan.ilan_metni|truncatechars:120 }}
            </p>

            <div class="flex items-center text-sm text-gray-500 gap-4 mb-4">
                <div class="flex items-center gap-1">
                    <i class="fas fa-map-marker-alt text-yellow-500"></i>
                    <span>{{ ilan.konum|default:"Konum belirtilmedi." }}</span>
                </div>
                <div class="flex items-center gap-1">
                    <i class="fas fa-briefcase text-yellow-500"></i>
                    <span>{{ ilan.is_deneyimi|default:"İş deneyimi belirtilmedi." }}</span>
                </div>
            </div>

            <div class="mt-auto pt-4 border-t border-gray-100 flex justify-between items-center">
                <div>
                    <span class="text-xs text-gray-500">İstenilen Ücret:</span>
                    <span class="text-lg font-bold text-green-600 ucret" data-value="{{ ilan.istenilen_ucret }}">
    {{ ilan.istenilen_ucret }} ₺</span>
                </div>
                <a href="/uygulama/@{{ ilan.ilan_sahibi.slug }}/{{ilan.slug}}/"
                class="text-yellow-700 bg-yellow-50 hover:bg-yellow-100 px-4 py-2 rounded-lg text-sm font-medium transition-colors group-hover:bg-yellow-100 flex items-center">
                    <span>İncele</span>
                    <i class="fas fa-arrow-right text-lg ml-1"></i>
                </a>
            </div>
        </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% if ilanlar.has_other_pages %}
    <div class="mt-12 flex justify-center">
        <nav class="flex items-center space-x-2">
            {% if ilanlar.has_previous %}
            <a href="?page={{ ilanlar.previous_page_number }}{% if kelime %}&kelime={{ kelime }}{% endif %}{% if konum %}&konum={{ konum }}{% endif %}{% if min_ucret %}&min_ucret={{ min_ucret }}{% endif %}{% if max_ucret %}&max_ucret={{ max_ucret }}{% endif %}{% if kategori %}&kategori={{ kategori }}{% endif %}" 
               class="px-3 py-2 rounded-lg border border-gray-300 text-gray-500 hover:bg-yellow-50 hover:text-yellow-600 transition">
                &laquo;
            </a>
            {% endif %}

            {% for i in ilanlar.paginator.page_range %}
                {% if ilanlar.number == i %}
                <span class="px-3 py-2 rounded-lg bg-yellow-500 text-white font-medium">{{ i }}</span>
                {% else %}
                <a href="?page={{ i }}{% if kelime %}&kelime={{ kelime }}{% endif %}{% if konum %}&konum={{ konum }}{% endif %}{% if min_ucret %}&min_ucret={{ min_ucret }}{% endif %}{% if max_ucret %}&max_ucret={{ max_ucret }}{% endif %}{% if kategori %}&kategori={{ kategori }}{% endif %}" 
                   class="px-3 py-2 rounded-lg border border-gray-300 text-gray-500 hover:bg-yellow-50 hover:text-yellow-600 transition">
                    {{ i }}
                </a>
                {% endif %}
            {% endfor %}

            {% if ilanlar.has_next %}
            <a href="?page={{ ilanlar.next_page_number }}{% if kelime %}&kelime={{ kelime }}{% endif %}{% if konum %}&konum={{ konum }}{% endif %}{% if min_ucret %}&min_ucret={{ min_ucret }}{% endif %}{% if max_ucret %}&max_ucret={{ max_ucret }}{% endif %}{% if kategori %}&kategori={{ kategori }}{% endif %}" 
               class="px-3 py-2 rounded-lg border border-gray-300 text-gray-500 hover:bg-yellow-50 hover:text-yellow-600 transition">
                &raquo;
            </a>
            {% endif %}
        </nav>
    </div>
    {% endif %}

    {% else %}
    <div class="text-center py-16 bg-white rounded-xl border border-gray-200">
        <svg class="mx-auto h-16 w-16 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="mt-4 text-lg font-medium text-gray-900">Sonuç bulunamadı</h3>
        <p class="mt-2 text-gray-500">Aramanızla eşleşen ilan bulunamadı. Lütfen farklı kriterlerle tekrar deneyin.</p>
        <div class="mt-6">
            <a href="{% url 'ilan_ara' %}" class="inline-flex items-center px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition">
                Filtreleri Temizle
            </a>
        </div>
    </div>
    {% endif %}
</div>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    select {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 0.5rem center;
        background-repeat: no-repeat;
        background-size: 1.5em 1.5em;
        padding-right: 2.5rem;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
</style>

<script>
   document.addEventListener('DOMContentLoaded', function () {
    const ucretElements = document.querySelectorAll(".ucret");
    ucretElements.forEach(el => {
        const value = parseInt(el.dataset.value, 10) || 0;
        el.textContent = value.toLocaleString("tr-TR") + " ₺";
    });
}); 
</script>
{% endblock %}