{% extends 'base.jinja' %}
{% load static %}

{% block title %}Profilim{% endblock %}

{% block content %}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Profil Üst Bilgi -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl shadow-lg overflow-hidden mb-8">
        <div class="md:flex">
            <div class="md:flex-shrink-0 p-8 flex justify-center items-center">
                <div class="relative">
                    <div class="w-40 h-40 rounded-full border-4 border-white shadow-xl overflow-hidden">
                        <img class="w-full h-full object-cover"
                            src="{% if request.user.avatar %}{{request.user.avatar.url}}{% else %}{% static  'images/blank-profile.jpg' %}{% endif %}"
                            alt="Profil Fotoğrafı">
                    </div>
                    {% if request.user.is_online %}
                    <div class="absolute bottom-2 right-2 bg-white rounded-full p-1 shadow-md">
                        <div class="bg-green-500 rounded-full p-1.5"></div>
                    </div>
                    {% endif %}
                </div>
            </div>
            <div class="p-8 flex-1">
                <div class="flex flex-col md:flex-row md:items-center justify-between">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-900">{{request.user.get_full_name}}</h1>
                        <p class="text-gray-600 mt-2 flex items-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                </path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            {% if request.user.konum %}
                            {{request.user.konum}}
                            {% else %}
                            Konum belirtilmedi
                            {% endif %}
                        </p>
                    </div>
                    {% if request.user.is_superuser %}
                    <div class="mt-4 md:mt-0 flex items-center">
                        <span
                            class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
                            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M10 2C10 2 3 5 3 10C3 15 10 18 10 18C10 18 17 15 17 10C17 5 10 2 10 2ZM10 4.5L14.5 6.5V10C14.5 13.5 12 15.5 10 16.5C8 15.5 5.5 13.5 5.5 10V6.5L10 4.5Z" />
                            </svg>
                            Yönetici Hesap
                        </span>
                    </div>

                    {% elif request.user.onayli_kullanici %}
                    <div class="mt-4 md:mt-0 flex items-center">
                        <span
                            class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">
                            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.163c.969 0 1.371 1.24.588 1.81l-3.37 2.448a1 1 0 00-.364 1.118l1.286 3.957c.3.921-.755 1.688-1.538 1.118l-3.37-2.448a1 1 0 00-1.176 0l-3.37 2.448c-.783.57-1.838-.197-1.538-1.118l1.286-3.957a1 1 0 00-.364-1.118L2.072 9.384c-.783-.57-.38-1.81.588-1.81h4.163a1 1 0 00.95-.69l1.286-3.957z" />
                            </svg>
                            Onaylı Profil
                        </span>
                    </div>
                    {% endif %}
                </div>

                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="/uygulama/profil/duzenle"
                        class="px-5 py-2.5 bg-yellow-500 text-white font-medium rounded-lg shadow-md hover:shadow-lg transition-all duration-300 flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                            </path>
                        </svg>
                        Profili Düzenle
                    </a>

                    <a href="/uygulama/ilan-ekle/"
                        class="px-5 py-2.5 border border-gray-300 rounded-lg shadow-sm hover:shadow-md transition-all duration-300 flex items-center bg-white">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                        </svg>
                        İlan Oluştur
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- İstatistik Kartları -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div
            class="bg-white rounded-2xl shadow-md p-6 border-l-4 border-blue-500 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center">
                <div class="p-3 rounded-lg bg-blue-100 text-blue-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                        </path>
                    </svg>
                </div>
                <div class="ml-4">
                    <h3 class="text-sm font-medium text-gray-500">Toplam İlan</h3>
                    <p class="text-2xl font-bold text-gray-900">{{ ilanlar|length }}</p>
                </div>
            </div>
        </div>

        <div
            class="bg-white rounded-2xl shadow-md p-6 border-l-4 border-green-500 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center">
                <div class="p-3 rounded-lg bg-green-100 text-green-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905a3.61 3.61 0 01-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5">
                        </path>
                    </svg>
                </div>
                <div class="ml-4">
                    <h3 class="text-sm font-medium text-gray-500">Topluluk Değerlendirmesi</h3>
                    <p class="text-2xl font-bold text-gray-900">İyi</p>
                </div>
            </div>
        </div>

        <div
            class="bg-white rounded-2xl shadow-md p-6 border-l-4 border-purple-500 hover:shadow-lg transition-all duration-300">
            <div class="flex items-center">
                <div class="p-3 rounded-lg bg-purple-100 text-purple-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="ml-4">
                    <h3 class="text-sm font-medium text-gray-500">Mesaja Dönüş Süresi</h3>
                    <p class="text-2xl font-bold text-gray-900">2 Saat</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Sekmeler -->
    <div class="bg-white rounded-2xl shadow-md overflow-hidden mb-8">
        <div class="border-b border-gray-200">
            <nav class="flex -mb-px">
                <button id="about-tab" data-tabs-target="#about" type="button"
                    class="py-4 px-6 text-sm font-medium border-b-2 border-yellow-500 text-yellow-600 flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    Hakkında
                </button>
                <button id="services-tab" data-tabs-target="#services" type="button"
                    class="py-4 px-6 text-sm font-medium text-gray-500 hover:text-gray-700 border-b-2 border-transparent hover:border-gray-300 flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                        </path>
                    </svg>
                    İlanlar
                </button>
                <button id="reviews-tab" data-tabs-target="#reviews" type="button"
                    class="py-4 px-6 text-sm font-medium text-gray-500 hover:text-gray-700 border-b-2 border-transparent hover:border-gray-300 flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z">
                        </path>
                    </svg>
                    Yorumlar
                </button>
            </nav>
        </div>

        <!-- İçerik Alanları -->
        <div class="p-6">
            <!-- Hakkında Sekmesi -->
            <div id="about" class="tab-content">
                <h2 class="text-xl font-semibold mb-4 text-gray-800">{{request.user.get_full_name}} kimdir?</h2>
                <div class="bg-gray-50 rounded-lg p-6">
                    <p class="text-gray-700 leading-relaxed">
                        {% if request.user.biyografi %}
                        {{request.user.biyografi}}
                        {% else %}
                        <span class="text-gray-400 italic">Biyografi belirtilmedi. Profilinizi düzenleyerek kendiniz
                            hakkında bilgi ekleyebilirsiniz.</span>
                        {% endif %}
                    </p>
                </div>

                <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                        <h3 class="font-medium text-gray-700 mb-2 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z">
                                </path>
                            </svg>
                            İletişim Bilgileri
                        </h3>
                        <p class="text-gray-600">
                        {% if request.user.iletisim_bilgilerimi_goster %}
                            {{request.user.email}}
                        {% else %}
                            {{ request.user.email|slice:":1" }}***@***
                        {% endif %}
                        </p>
                        {% if request.user.phone %}
                        <p class="text-gray-600 mt-1">{{request.user.phone}}</p>
                        {% endif %}
                    </div>

                    <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                        <h3 class="font-medium text-gray-700 mb-2 flex items-center">
                            <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            Üyelik Tarihi
                        </h3>
                        <p class="text-gray-600">{{request.user.date_joined|date:"d F Y"}}</p>
                    </div>
                </div>
            </div>

            <!-- İlanlar Sekmesi -->
            <div id="services" class="tab-content hidden">
                {% if ilanlar %}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for ilan in ilanlar %}
                    <div
                        class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                        <div class="p-6">
                            <div class="flex items-center mb-4">
                                {% if ilan.ilan_sahibi.avatar %}
                                <img src="{{ ilan.ilan_sahibi.avatar.url }}" alt="{{ ilan.ilan_sahibi.first_name }}"
                                    class="w-12 h-12 rounded-full object-cover mr-3 shadow-md">
                                {% else %}
                                <div
                                    class="w-12 h-12 rounded-full bg-gray-400 flex items-center justify-center mr-3 text-white font-bold shadow-md">
                                    {{ ilan.ilan_sahibi.first_name|slice:":1" }}
                                </div>
                                {% endif %}
                                <div>
                                    <p class="font-semibold text-gray-800">{{ ilan.ilan_sahibi.get_full_name }}</p>
                                    <p class="text-xs text-gray-500">{{ ilan.olusturulma_tarihi|date:"d M Y" }}</p>
                                </div>
                            </div>

                            <h3 class="font-bold text-gray-900 text-lg mb-2">{{ ilan.ilan_baslik }}</h3>
                            <p class="text-gray-600 text-sm mb-4 line-clamp-6">{{ ilan.ilan_metni|truncatechars:600 }}
                            </p>

                            <div class="space-y-2 mb-4">
                                <p class="text-gray-500 text-sm flex items-center">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                        </path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    {{ilan.konum|default:"Konum belirtilmedi" }}
                                </p>
                                <p class="text-gray-500 text-sm flex items-center">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    {{ilan.is_deneyimi|truncatechars:30|default:"Deneyim belirtilmedi" }}
                                </p>
                            </div>

                            <div class="flex items-center justify-between mt-4">
                                <span class="font-semibold text-green-600 text-lg">{{ilan.istenilen_ucret}} ₺</span>
                                <div class="flex space-x-2">
                                    <a href="/uygulama/ilan-duzenle/{{ilan.id}}/"
                                        class="px-3 py-1.5 bg-yellow-500 hover:bg-yellow-600 text-white text-xs rounded-lg transition-colors duration-200">Düzenle</a>
                                    <a href="/uygulama/ilan-sil/{{ilan.id}}/"
                                        class="px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-xs rounded-lg transition-colors duration-200">Sil</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="text-center py-12">
                    <svg class="w-16 h-16 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                        </path>
                    </svg>
                    <h3 class="mt-4 text-lg font-medium text-gray-900">Henüz ilanınız bulunmuyor</h3>
                    <p class="mt-2 text-gray-500">İlk ilanınızı oluşturarak iş teklifleri almaya başlayabilirsiniz.</p>
                    <div class="mt-6">
                        <a href="/uygulama/ilan-ekle/"
                            class="px-5 py-2.5 bg-yellow-500 text-white rounded-lg shadow-md hover:shadow-lg transition-all duration-300 inline-flex items-center">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                            </svg>
                            İlan Oluştur
                        </a>
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Yorumlar Sekmesi -->
            <div id="reviews" class="tab-content hidden">
                <div class="text-center py-12">
                    <svg class="w-16 h-16 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                        </path>
                    </svg>
                    <h3 class="mt-4 text-lg font-medium text-gray-900">Henüz yorumunuz bulunmuyor</h3>
                    <p class="mt-2 text-gray-500">İlanlarınızı yayınladıktan sonra müşterileriniz yorum bırakabilir.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tab-content {
        animation: fadeIn 0.5s ease-in-out;
    }

    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .bg-gradient-to-r {
        background-image: linear-gradient(to right, var(--tw-gradient-stops));
    }
</style>

<script>
    // Sekme değiştirme işlevselliği
    document.addEventListener('DOMContentLoaded', function () {
        const tabs = document.querySelectorAll('[data-tabs-target]');
        const tabContents = document.querySelectorAll('.tab-content');

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const target = document.querySelector(tab.getAttribute('data-tabs-target'));

                // Tüm içerikleri gizle
                tabContents.forEach(content => {
                    content.classList.add('hidden');
                });

                // Tüm sekmeleri pasif yap
                tabs.forEach(t => {
                    t.classList.remove('border-yellow-500', 'text-yellow-600');
                    t.classList.add('border-transparent', 'text-gray-500', 'hover:text-gray-700');
                });

                // Aktif sekme yap
                tab.classList.remove('border-transparent', 'text-gray-500', 'hover:text-gray-700');
                tab.classList.add('border-yellow-500', 'text-yellow-600');

                // Hedef içeriği göster
                target.classList.remove('hidden');
            });
        });
    });
</script>

{% endblock %}