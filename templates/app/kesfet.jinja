{% extends 'base.jinja' %}
{% load static %}

{% block title %}Keşfet{% endblock %}

{% block content %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
    crossorigin="anonymous" referrerpolicy="no-referrer" />

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .popular-search {
        font-weight: normal !important;
        text-decoration: none !important;
    }
</style>

<section class="relative bg-yellow-500 py-16 md:py-24">
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
    <div class="relative container mx-auto px-4 md:px-6 text-center">
        {% if not request.user.is_authenticated %}
        <div class="flex justify-center mb-6">
            <a href="/uygulama/giris-yap/"
                class="inline-flex items-center py-2 px-4 pe-5 bg-white/90 backdrop-blur-sm rounded-full shadow-md hover:shadow-lg transition-all duration-300 text-yellow-800 font-medium">
                <span class="bg-yellow-500 text-white text-xs px-3 py-1 rounded-full me-2">Bilgilendirme</span>
                <span class="text-sm">Uygulamayı kullanabilmek için giriş yapmalısın</span>
                <svg class="w-3 h-3 ms-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="m1 9 4-4-4-4" />
                </svg>
            </a>
        </div>
        {% endif %}

        <h1 class="mb-4 text-4xl md:text-5xl lg:text-6xl font-extrabold text-white drop-shadow-md">
            Neye <span class="text-yellow-900 underline decoration-yellow-200 decoration-3">ihtiyacın</span> var?
        </h1>
        <p class="mb-8 text-lg md:text-xl font-medium text-yellow-100 max-w-2xl mx-auto">
            İhtiyacın olanı bulmana sandığından daha yakınsın.
        </p>

        <div class="max-w-2xl mx-auto mt-8">
            <form method="get" action="{% url 'ilan_ara' %}"
                class="flex items-center bg-white rounded-xl shadow-lg overflow-hidden border border-yellow-300">
                <div class="flex-grow relative">
                    <input type="text" name="kelime"
                        class="w-full p-4 text-gray-700 focus:outline-none focus:ring-2 focus:ring-yellow-400 rounded-l-xl"
                        placeholder="Ne arıyorsunuz?" />
                    <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                        <i class="fas fa-search text-gray-400"></i>
                    </div>
                </div>
                <button type="button" data-modal-target="filtreModal" data-modal-toggle="filtreModal"
                    class="px-4 py-4 text-yellow-600 hover:text-yellow-700 transition-colors">
                    <i class="fas fa-filter text-lg"></i>
                </button>
                <div class="h-6 border-l border-gray-200"></div>
                <button type="submit"
                    class="bg-yellow-600 hover:bg-yellow-700 text-white px-5 py-4 transition-colors flex items-center">
                    <span class="me-2">Ara</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>
        </div>

        <div class="mt-6 flex flex-wrap justify-center items-center gap-2">
            <span class="text-yellow-100 text-sm font-medium">Popüler aramalar:</span>
            <a href="{% url 'ilan_ara' %}?kelime=Tamir"
                class="popular-search text-yellow-100 hover:text-white text-sm bg-yellow-600/30 hover:bg-yellow-600/50 px-3 py-1 rounded-full transition-colors">
                Tamir
            </a>
            <a href="{% url 'ilan_ara' %}?kelime=Yazılım"
                class="popular-search text-yellow-100 hover:text-white text-sm bg-yellow-600/30 hover:bg-yellow-600/50 px-3 py-1 rounded-full transition-colors">
                Yazılım
            </a>
            <a href="{% url 'ilan_ara' %}?kelime=Danışman"
                class="popular-search text-yellow-100 hover:text-white text-sm bg-yellow-600/30 hover:bg-yellow-600/50 px-3 py-1 rounded-full transition-colors">
                Danışman
            </a>
            <a href="{% url 'ilan_ara' %}?kelime=Satış"
                class="popular-search text-yellow-100 hover:text-white text-sm bg-yellow-600/30 hover:bg-yellow-600/50 px-3 py-1 rounded-full transition-colors">
                Satış
            </a>
        </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-8 bg-yellow-500 rounded-t-3xl"></div>
</section>

<div id="filtreModal" tabindex="-1" aria-hidden="true"
    class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
    <div class="bg-white rounded-xl shadow-xl w-full max-w-md overflow-hidden">
        <div class="flex items-center justify-between p-5 border-b">
            <h3 class="text-xl font-semibold text-gray-900">Filtreleme Seçenekleri</h3>
            <button type="button" data-modal-hide="filtreModal"
                class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <form method="get" action="{% url 'ilan_ara' %}" class="p-5">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Konum</label>
                <div class="relative">
                    <input type="text" name="konum"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400">
                    <i class="fas fa-map-marker-alt absolute right-3 top-3.5 text-gray-400"></i>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Min Ücret (₺)</label>
                    <input type="number" name="min_ucret"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Max Ücret (₺)</label>
                    <input type="number" name="max_ucret"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400">
                </div>
            </div>

            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-2">Kategori</label>
                <select name="kategori"
                        class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-400 focus:border-yellow-400">
                    <option value="">Tüm Kategoriler</option>
                    <option value="teknoloji">Teknoloji</option>
                    <option value="sanat">Sanat</option>
                    <option value="tamir">Tamir</option>
                    <option value="eglence">Eğlence</option>
                    <option value="egitim">Eğitim</option>
                    <option value="saglik">Sağlık</option>
                    <option value="moda">Moda</option>
                    <option value="diger">Diğer</option>
                </select>
            </div>


            <div class="flex justify-between mt-6">
                <button type="button" data-modal-hide="filtreModal"
                    class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition-colors">
                    Vazgeç
                </button>
                <div class="flex gap-2">
                    <button type="reset"
                        class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition-colors">
                        Sıfırla
                    </button>
                    <button type="submit"
                        class="px-5 py-2.5 bg-yellow-500 hover:bg-yellow-600 text-white rounded-lg font-medium transition-colors flex items-center">
                        <i class="fas fa-filter me-2"></i>
                        Filtrele
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        {% if request.user.is_authenticated %}
        <div class="mb-10">
            <h2 class="text-3xl font-bold text-gray-900">
                Hoşgeldin, <span class="text-yellow-600">{{ request.user.first_name }}</span>
            </h2>
            <p class="mt-2 text-gray-600">En son yayınlanan ilanlara göz at.</p>
        </div>
        {% endif %}

        <div class="flex flex-wrap gap-4 mb-6">
            <button class="px-4 py-2 bg-yellow-500 text-white rounded-full text-sm font-medium flex items-center">
                <i class="fas fa-bolt me-2"></i>
                İlanlar
            </button>
        </div>

        {% if ilanlar %}
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for ilan in ilanlar %}
            <div
                class="bg-white rounded-2xl shadow-sm p-6 flex flex-col hover:shadow-md transition-all duration-300 border border-gray-100 group">
                <div class="flex items-center gap-4 mb-4">
                    <div class="relative">
                        <img class="w-12 h-12 rounded-full object-cover border-2 border-white shadow"
                            src="{% if ilan.ilan_sahibi.avatar %}{{ ilan.ilan_sahibi.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}"
                            alt="{{ ilan.ilan_sahibi }}">
                        <span
                            class="absolute -bottom-1 -right-1 bg-yellow-400 text-white text-xs font-bold w-5 h-5 rounded-full flex items-center justify-center">
                            <i class="fas fa-star text-xs"></i>
                        </span>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">
                            {{ ilan.ilan_sahibi.get_full_name|default:ilan.ilan_sahibi }}</h3>
                        {% if ilan.ilan_sahibi.is_superuser %}
                        <div class="flex items-center text-xs text-gray-500">
                            <i class="fas fa-check-circle text-red-500 me-1"></i>
                            <span>Yönetici</span>
                        </div>
                        {% elif ilan.ilan_sahibi.onayli_kullanici %}
                        <div class="flex items-center text-xs text-gray-500">
                            <i class="fas fa-check-circle text-yellow-500 me-1"></i>
                            <span>Doğrulanmış Kullanıcı</span>
                        </div>
                        {% endif%}
                    </div>
                </div>

                <h4 class="text-lg font-bold text-gray-800 mb-2 line-clamp-1">{{ ilan.ilan_baslik }}</h4>
                <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                    {{ ilan.ilan_metni|truncatechars:120 }}
                </p>

                <div class="flex items-center text-sm text-gray-500 gap-4 mb-4">
                    <div class="flex items-center gap-1">
                        <i class="fas fa-map-marker-alt text-yellow-500"></i>
                        <span>{{ ilan.konum|default:"Konum belirtilmedi." }}</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <i class="fas fa-briefcase text-yellow-500"></i>
                        <span>{{ ilan.is_deneyimi|default:"İş deneyimi belirtilmedi." }}</span>
                    </div>
                </div>

                <div class="mt-auto pt-4 border-t border-gray-100 flex justify-between items-center">
                    <div>
                        <span class="text-xs text-gray-500">İstenilen Ücret:</span>
                        <span class="text-lg font-bold text-green-600">{{ ilan.istenilen_ucret }} ₺</span>
                    </div>
                    <a href="/uygulama/@{{ ilan.ilan_sahibi.slug }}"
                    class="text-yellow-700 bg-yellow-50 hover:bg-yellow-100 px-4 py-2 rounded-lg text-sm font-medium transition-colors group-hover:bg-yellow-100 flex items-center">
                        <span>İncele</span>
                        <i class="fas fa-arrow-right text-lg ml-1"></i>
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="mt-10 flex justify-center">
            <nav class="flex items-center gap-1">
                {% if ilanlar.has_previous %}
                    <a href="?sayfa={{ ilanlar.previous_page_number }}"
                    class="px-3 py-2 rounded-lg bg-white text-gray-700 hover:bg-gray-50 font-medium">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                {% endif %}

                {% for num in ilanlar.paginator.page_range %}
                    {% if ilanlar.number == num %}
                        <span class="px-3 py-2 rounded-lg bg-yellow-500 text-white font-medium">{{ num }}</span>
                    {% else %}
                        <a href="?sayfa={{ num }}"
                        class="px-3 py-2 rounded-lg bg-white text-gray-700 hover:bg-gray-50 font-medium">{{ num }}</a>
                    {% endif %}
                {% endfor %}

                {% if ilanlar.has_next %}
                    <a href="?sayfa={{ ilanlar.next_page_number }}"
                    class="px-3 py-2 rounded-lg bg-white text-gray-700 hover:bg-gray-50 font-medium">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                {% endif %}
            </nav>
        </div>

        {% else %}
        <div class="text-center py-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-yellow-100 rounded-full mb-4">
                <i class="fas fa-inbox text-3xl text-yellow-600"></i>
            </div>
            <h3 class="text-xl font-medium text-gray-900 mb-2">Henüz ilan bulunmuyor</h3>
            <p class="text-gray-600 max-w-md mx-auto">Şu anda gösterilecek ilan bulunamadı. Biraz sonra tekrar kontrol
                etmeyi unutma.</p>
        </div>
        {% endif %}
    </div>
</section>

<section class="py-12 bg-white">
    <div class="container mx-auto px-4 md:px-6">
        <div class="bg-yellow-500 rounded-2xl shadow-lg overflow-hidden">
            <div class="md:flex items-center">
                <div class="p-8 md:p-12 md:w-2/3">
                    <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Alıcı Talebi <span
                            class="text-yellow-900">Oluştur</span></h2>
                    <p class="text-yellow-100 mb-6 max-w-md">
                        İhtiyacını topluluğumuzda duyur. Alıcı talebi oluşturarak alanında yetenekli insanların sana
                        ulaşmasını sağla.
                    </p>
                    <a href="/uygulama/alici-talebi-olustur/"
                        class="inline-flex items-center px-5 py-3 bg-white text-yellow-700 font-medium rounded-lg shadow-md hover:bg-gray-50 transition">
                        <i class="fas fa-plus-circle me-2"></i>
                        Alıcı Talebi Oluştur
                    </a>
                </div>
                <div class="hidden md:block md:w-1/3">
                    <div class="relative h-full">
                        <div class="absolute -top-4 -left-4 w-32 h-32 bg-yellow-300 rounded-full opacity-20"></div>
                        <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-yellow-200 rounded-full opacity-30"></div>
                        <div class="relative p-6 flex justify-center items-center h-full">
                            <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-4 border border-white/30">
                                <i class="fas fa-bullhorn text-5xl text-white"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-gray-900">Popüler <span class="text-yellow-600">Kategoriler</span></h2>
            <p class="mt-2 text-gray-600">Farklı kategorilerdeki hizmetleri keşfet</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            <a href="{% url 'ilan_ara' %}?kategori=egitim"
               class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-300 group text-center">
                <div class="inline-flex items-center justify-center w-14 h-14 bg-yellow-100 rounded-lg mb-4 group-hover:bg-yellow-200 transition-colors">
                    <i class="fas fa-graduation-cap text-2xl text-yellow-600"></i>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">Eğitim</h3>
                <p class="text-sm text-gray-500">{{ kategori_sayilari.egitim }} ilan</p>
            </a>

            <a href="{% url 'ilan_ara' %}?kategori=teknoloji"
               class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-300 group text-center">
                <div class="inline-flex items-center justify-center w-14 h-14 bg-yellow-100 rounded-lg mb-4 group-hover:bg-yellow-200 transition-colors">
                    <i class="fas fa-laptop-code text-2xl text-yellow-600"></i>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">Teknoloji</h3>
                <p class="text-sm text-gray-500">{{ kategori_sayilari.teknoloji }} ilan</p>
            </a>

            <a href="{% url 'ilan_ara' %}?kategori=eglence"
               class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-300 group text-center">
                <div class="inline-flex items-center justify-center w-14 h-14 bg-yellow-100 rounded-lg mb-4 group-hover:bg-yellow-200 transition-colors">
                    <i class="fas fa-theater-masks text-2xl text-yellow-600"></i>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">Eğlence</h3>
                <p class="text-sm text-gray-500">{{ kategori_sayilari.eglence }} ilan</p>
            </a>

            <a href="{% url 'ilan_ara' %}?kategori=moda"
               class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:shadow-md transition-all duration-300 group text-center">
                <div class="inline-flex items-center justify-center w-14 h-14 bg-yellow-100 rounded-lg mb-4 group-hover:bg-yellow-200 transition-colors">
                    <i class="fas fa-tshirt text-2xl text-yellow-600"></i>
                </div>
                <h3 class="font-semibold text-gray-900 mb-1">Moda</h3>
                <p class="text-sm text-gray-500">{{ kategori_sayilari.moda }} ilan</p>
            </a>
        </div>

        <div class="text-center mt-8">
            <a href="/uygulama/ara/" class="inline-flex items-center text-yellow-600 hover:text-yellow-700 font-medium">
                <span>Tüm kategorileri görüntüle</span>
                <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>


{% include 'components/_footer.jinja' %}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const icons = document.querySelectorAll('i');
        icons.forEach(icon => {
            if (getComputedStyle(icon, ':before').content === '""') {
                console.log('Font Awesome yüklenmedi');
                if (icon.classList.contains('fa-search')) {
                    icon.textContent = '🔍';
                } else if (icon.classList.contains('fa-filter')) {
                    icon.textContent = '⚙️';
                }
            }
        });
    });
</script>
{% endblock %}