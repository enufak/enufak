{% extends "base.jinja" %}

{% block title %}Alıcı Talepleri{% endblock %}

{% block content %}

<head>
    <style>
        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .card-hover {
            transition: all 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }
        .filter-btn.active {
            background-color: #eab308;
            color: white;
        }
        .stat-card {
            transition: all 0.3s ease;
        }
        .stat-card:hover {
            transform: translateY(-3px);
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <!-- Container -->
    <div class="max-w-7xl mx-auto px-4 py-8">
        <!-- Başlık ve Filtreler -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
            <h1 class="text-3xl font-bold text-gray-800 mb-4 md:mb-0">
                <i class="fas fa-handshake mr-2 text-yellow-500"></i>Alıcı Talepleri
            </h1>
            
            <div class="flex flex-wrap gap-2">
                <button class="filter-btn active px-4 py-2 rounded-full text-sm font-medium bg-yellow-500 text-white">
                    Tümü
                </button>
            </div>
        </div>

        <!-- İstatistik Kartları -->
        <div class="grid grid-cols-1 md:grid-cols-1 gap-5 mb-8">
            <div class="stat-card bg-white rounded-lg shadow p-5 flex items-center">
                <div class="h-12 w-12 rounded-lg bg-yellow-100 flex items-center justify-center mr-4">
                    <i class="fas fa-list text-yellow-600 text-xl"></i>
                </div>
                <div>
                    <p class="text-gray-500 text-sm">Toplam Talep</p>
                    <p class="text-2xl font-bold text-gray-800">{{ talepler|length }}</p>
                </div>
            </div>
        </div>

        <!-- Talep Listesi -->
        {% if talepler %}
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for talep in talepler %}
            <div class="border border-gray-200 rounded-xl p-6 card-hover bg-white flex flex-col justify-between h-full">
                <div>
                    <!-- Talep Başlığı ve Durumu -->
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-lg font-semibold text-gray-800">{{ talep.baslik }}</h3>
                        <span class="text-xs font-medium px-2 py-1 rounded-full {% if talep.acil %}bg-red-100 text-red-800{% else %}bg-gray-100 text-gray-800{% endif %}">
                            {% if talep.acil %}Acil{% else %}Standart{% endif %}
                        </span>
                    </div>
                    
                    <!-- Talep Açıklaması -->
                    <p class="text-gray-600 text-sm mb-4 line-clamp-3">{{ talep.metin }}</p>
                    
                </div>

                <div>
                    <!-- Süre ve Bütçe -->
                    <div class="flex justify-between items-center mb-4 text-sm text-gray-700">
                        <span class="font-medium text-gray-500">
                            <i class="far fa-clock mr-1 text-yellow-500"></i>{{ talep.get_süre_display }}
                        </span>
                        <span class="font-bold text-green-600">
                            ₺ {{ talep.butce }}
                        </span>
                    </div>
                    
                    <!-- Kullanıcı Bilgisi -->
                    <div class="flex items-center mb-4 p-3 bg-gray-50 rounded-lg">
                        <div class="h-8 w-8 rounded-full bg-yellow-500 flex items-center justify-center text-white font-bold text-sm mr-3">
                            {{ talep.yazar.get_full_name|first|upper }}
                        </div>
                        <div>
                            <p class="text-xs font-medium text-gray-700">{{ talep.yazar.get_full_name }}</p>
                            <p class="text-xs text-gray-500">{{ talep.konum|default:"Konum belirtilmedi." }}</p>
                        </div>
                    </div>

                    <!-- Mesaj Butonu -->
                    <a href="/uygulama/@{{talep.yazar.slug}}/"
                        class="w-full flex items-center justify-center py-3 bg-yellow-500 text-white font-medium rounded-lg shadow hover:bg-yellow-600 transition">
                        <i class="far fa-envelope mr-2"></i>Mesaj Gönder
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>

        {% else %}
        <!-- Talep Yoksa Gösterilecek İçerik -->
        <div class="text-center py-16">
            <div class="inline-flex items-center justify-center h-16 w-16 rounded-full bg-yellow-100 text-yellow-500 mb-4">
                <i class="fas fa-inbox text-2xl"></i>
            </div>
            <h3 class="text-xl font-medium text-gray-700 mb-2">Henüz talep bulunmuyor</h3>
            <p class="text-gray-500 max-w-md mx-auto">Şu anda görüntülenecek alıcı talebi bulunmamaktadır. Lütfen daha sonra tekrar kontrol edin.</p>
            <button class="mt-6 px-6 py-3 bg-yellow-500 text-white font-medium rounded-lg shadow hover:bg-yellow-600 transition">
                <i class="fas fa-sync-alt mr-2"></i>Yenile
            </button>
        </div>
        {% endif %}
    </div>

    <script>
        // Filtre butonları için aktif class toggle
        document.querySelectorAll('.filter-btn').forEach(button => {
            button.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(btn => {
                    btn.classList.remove('active', 'bg-yellow-500', 'text-white');
                    btn.classList.add('bg-gray-200', 'text-gray-700');
                });
                this.classList.add('active', 'bg-yellow-500', 'text-white');
                this.classList.remove('bg-gray-200', 'text-gray-700');
            });
        });
    </script>
</body>
</html>
{% endblock %}