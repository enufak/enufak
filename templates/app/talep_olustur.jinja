{% extends "base.jinja" %}
{% load crispy_forms_tags %}

{% block title %}Alıcı Talebi Oluştur{% endblock %}

{% block content %}
<section class="max-w-3xl mx-auto py-12">
    <div class="bg-white p-8 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold text-gray-800 mb-4">Alıcı Talebi Oluştur</h2>
        <p class="text-gray-600 mb-6">
            İhtiyacını topluluğumuzda duyur. Alıcı talebi oluşturarak alanında yetenekli insanların sana ulaşmasını sağla.
        </p>

        <form method="POST">
            {% csrf_token %}
            {{ form|crispy }}

            <button type="submit"
                class="mt-4 w-full py-3 bg-yellow-600 text-white font-medium rounded-lg shadow hover:bg-yellow-700 transition">
                Alıcı Talebini Oluştur
            </button>
        </form>
    </div>
</section>
{% endblock %}
