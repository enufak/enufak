{% extends "base.jinja" %}
{% load crispy_forms_tags %}
{% load static %}

{% block title %}Alıcı Talebi Oluştur{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-gray-50 to-blue-50 py-8 px-4">
    <div class="max-w-4xl mx-auto">
        <!-- Başlık ve Geri Butonu -->
        <div class="flex items-center mb-8">
            <a href="javascript:history.back()" 
               class="inline-flex items-center px-4 py-3 bg-white text-gray-800 rounded-xl shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-0.5 mr-4">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-3xl font-bold text-gray-900">Alıcı Talebi Oluştur</h1>
        </div>

        <!-- Bilgi Kartı -->
        <div class="mb-8 p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 shadow-sm">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                        </svg>
                    </div>
                </div>
                <div class="ml-4">
                    <h3 class="text-lg font-semibold text-gray-900 mb-2">Topluluğa İhtiyacını Duyur</h3>
                    <p class="text-gray-700">
                        Alıcı talebi oluşturarak ihtiyacını topluluğumuzda duyurabilirsin. 
                        Alanında yetenekli insanlar sana ulaşsın ve tekliflerini sunsun.
                    </p>
                    <div class="mt-3 flex items-center text-sm text-blue-600">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Talep oluşturduktan sonra teklifleri değerlendirebilirsin
                    </div>
                </div>
            </div>
        </div>

        <!-- Talep Formu -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <div class="p-1 bg-gradient-to-r from-blue-500 to-indigo-600"></div>
            
            <form method="POST" class="p-8">
                {% csrf_token %}
                
                <!-- Form Başlığı -->
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-gray-900">Talep Detayları</h2>
                    <p class="text-gray-600 mt-2">İhtiyacını detaylı bir şekilde açıkla, daha iyi teklifler alırsın.</p>
                </div>
                
                <!-- Form Alanları -->
                <div class="space-y-6">
                    {% for field in form %}
                    <div class="form-group">
                        <label for="{{ field.id_for_label }}" class="block text-sm font-medium text-gray-700 mb-2 flex items-center">
                            <!-- İkonlar -->
                            {% if field.name == 'title' or field.name == 'name' %}
                            <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            {% elif field.name == 'description' or field.name == 'details' %}
                            <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"></path>
                            </svg>
                            {% elif field.name == 'budget' or field.name == 'price' %}
                            <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            {% elif field.name == 'category' or field.name == 'type' %}
                            <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                            </svg>
                            {% elif field.name == 'deadline' or field.name == 'due_date' %}
                            <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            {% elif field.name == 'location' or field.name == 'address' %}
                            <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            {% else %}
                            <svg class="w-4 h-4 text-blue-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            {% endif %}
                            {{ field.label }}
                        </label>
                        
                        {{ field }}
                        
                        {% if field.help_text %}
                        <p class="mt-2 text-sm text-gray-500">{{ field.help_text }}</p>
                        {% endif %}
                        {% for error in field.errors %}
                        <p class="mt-2 text-sm text-red-600">{{ error }}</p>
                        {% endfor %}
                    </div>
                    {% endfor %}
                </div>

                <!-- İpuçları Bölümü -->
                <div class="mt-8 p-4 bg-blue-50 rounded-lg border border-blue-200">
                    <h4 class="font-semibold text-blue-800 mb-2 flex items-center">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Daha İyi Teklifler Almak İçin:
                    </h4>
                    <ul class="text-sm text-blue-700 space-y-1">
                        <li>• İhtiyacınızı net ve detaylı açıklayın</li>
                        <li>• Gerçekçi bir bütçe aralığı belirleyin</li>
                        <li>• Beklediğiniz teslim tarihini mutlaka ekleyin</li>
                        <li>• İletişim bilgilerinizin doğru olduğundan emin olun</li>
                    </ul>
                </div>

                <!-- Buton -->
                <div class="mt-10 pt-6 border-t border-gray-200">
                    <button type="submit"
                            class="w-full py-3 bg-indigo-500 text-white font-medium rounded-lg hover:shadow-lg transition-all duration-300 transform hover:-translate-y-0.5 shadow-md flex items-center justify-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Alıcı Talebini Oluştur
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Özel CSS -->
<style>
    /* Form alanları için özel stil */
    input, textarea, select {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        transition: all 0.2s;
        font-size: 0.95rem;
    }
    
    input:focus, textarea:focus, select:focus {
        outline: none;
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    textarea {
        min-height: 120px;
        resize: vertical;
    }
    
    /* Checkbox ve radio butonları için özel stil */
    input[type="checkbox"], input[type="radio"] {
        width: auto;
        margin-right: 0.5rem;
    }
    
    /* Form grupları için boşluk */
    .form-group {
        margin-bottom: 1.5rem;
    }
</style>

<!-- JavaScript for Form Enhancement -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // İlk input alanına odaklan
        const firstInput = document.querySelector('input:not([type="hidden"]), textarea, select');
        if (firstInput) {
            firstInput.focus();
        }
        
        // Form gönderim animasyonu
        const form = document.querySelector('form');
        if (form) {
            form.addEventListener('submit', function(e) {
                const submitButton = this.querySelector('button[type="submit"]');
                if (submitButton) {
                    submitButton.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Talep Oluşturuluyor...';
                    submitButton.disabled = true;
                }
            });
        }
        
        // Karakter sayacı için (opsiyonel - description alanı için)
        const textarea = document.querySelector('textarea');
        if (textarea) {
            const charCount = document.createElement('div');
            charCount.className = 'text-sm text-gray-500 mt-1 text-right';
            textarea.parentNode.appendChild(charCount);
            
            textarea.addEventListener('input', function() {
                const maxLength = this.getAttribute('maxlength') || 1000;
                const currentLength = this.value.length;
                charCount.textContent = `${currentLength}/${maxLength} karakter`;
                
                if (currentLength > maxLength * 0.8) {
                    charCount.classList.add('text-yellow-600');
                    charCount.classList.remove('text-gray-500');
                } else {
                    charCount.classList.remove('text-yellow-600');
                    charCount.classList.add('text-gray-500');
                }
            });
            
            // İlk yüklemede karakter sayısını göster
            textarea.dispatchEvent(new Event('input'));
        }
    });
</script>
{% endblock %}