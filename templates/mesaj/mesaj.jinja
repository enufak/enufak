                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">😱</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">👍</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">👎</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">❤️</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">🔥</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">🎉</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">🙏</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">😇</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">🥰</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">🤗</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">🤩</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">😜</span>
                                <span class="emoji-item hover:bg-amber-100 rounded-lg p-2 text-center transition-colors">🤪</span>
