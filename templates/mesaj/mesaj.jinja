{% extends 'base.jinja' %}
{% load static %}

{% block title %}Mesaj - {{ other_user.get_full_name }}{% endblock %}

{% block content %}
<div class="flex flex-col md:flex-row h-screen bg-gray-100">
    <!-- Sol sidebar - Kullanıcı listesi (mobilde gizli, toggle ile açılır) -->
    <div class="w-full md:w-1/3 bg-white border-r border-gray-200 flex flex-col h-screen absolute md:relative z-10 -translate-x-full md:translate-x-0 transition-transform duration-300" id="kullanici-listesi-panel">
        <!-- Başlık ve menü butonu -->
        <div class="bg-yellow-500 px-4 py-4 flex-shrink-0 flex justify-between items-center">
            <h1 class="text-xl font-bold text-white flex items-center">
                <i class="fas fa-comments mr-2"></i>Mesajlarım
            </h1>
            <button id="kapat-menu" class="md:hidden text-white">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <!-- Arama kutusu -->
        <div class="p-3 bg-white border-b border-gray-200 flex-shrink-0">
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-gray-400"></i>
                </div>
                <input type="text" id="kullanici-ara" placeholder="Kullanıcı ara..." 
                    class="w-full pl-10 pr-4 py-2 bg-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:bg-white">
            </div>
        </div>
        
        <!-- Kullanıcı listesi scrollable -->
        <div class="flex-1 overflow-y-auto">
            <ul id="kullanici-listesi">
                {% for dm in dmler %}
                    {% if dm.from_user == request.user %}
                        {% with user=dm.to_user %}
                            <li class="kullanici-item flex items-center p-3 border-b border-gray-100 hover:bg-yellow-50 cursor-pointer transition"
                                onclick="sohbetAc({{ dm.id }})"
                                data-isim="{{ user.get_full_name|lower }}"
                                data-kullaniciadi="{{ user.username|lower }}">
                                <div class="relative flex-shrink-0">
                                    <img src="{% if user.avatar %}{{ user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                                         class="w-12 h-12 rounded-full object-cover border-2 border-yellow-200" 
                                         alt="{{ user.get_full_name }}">
                                    {% if user.is_online %}
                                    <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white"></span>
                                    {% endif %}
                                </div>
                                <div class="ml-3 flex-1 min-w-0">
                                    <div class="flex justify-between items-center">
                                        <p class="text-sm font-medium text-gray-900 truncate">{{ user.get_full_name }}</p>
                                        {% if dm.unread_count > 0 %}
                                        <span class="bg-red-600 text-white text-xs font-bold px-2 py-1 rounded-full">
                                            {{ dm.unread_count }}
                                        </span>
                                        {% endif %}
                                        <span class="text-xs text-gray-400">{{ dm.created_at|date:"H:i" }}</span>
                                    </div>
                                    <p class="text-xs text-gray-500 truncate">Mesajlara devam etmek için tıkla...</p>
                                </div>
                            </li>
                        {% endwith %}
                    {% else %}
                        {% with user=dm.from_user %}
                            <li class="kullanici-item flex items-center p-3 border-b border-gray-100 hover:bg-yellow-50 cursor-pointer transition"
                                onclick="sohbetAc({{ dm.id }})"
                                data-isim="{{ user.get_full_name|lower }}"
                                data-kullaniciadi="{{ user.username|lower }}">
                                <div class="relative flex-shrink-0">
                                    <img src="{% if user.avatar %}{{ user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                                         class="w-12 h-12 rounded-full object-cover border-2 border-yellow-200" 
                                         alt="{{ user.get_full_name }}">
                                    {% if user.is_online %}
                                    <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white"></span>
                                    {% endif %}
                                </div>
                                <div class="ml-3 flex-1 min-w-0">
                                    <div class="flex justify-between items-center">
                                        <p class="text-sm font-medium text-gray-900 truncate">{{ user.get_full_name }}</p>
                                        {% if dm.unread_count > 0 %}
                                        <span class="bg-red-600 text-white text-xs font-bold px-2 py-1 rounded-full">
                                            {{ dm.unread_count }}
                                        </span>
                                        {% endif %}
                                        <span class="text-xs text-gray-400">{{ dm.created_at|date:"H:i" }}</span>
                                    </div>
                                    <p class="text-xs text-gray-500 truncate">Mesajlara devam etmek için tıkla...</p>
                                </div>
                            </li>
                        {% endwith %}
                    {% endif %}
                {% empty %}
                    <!-- Mesaj yoksa -->
                    <li class="text-center py-8 px-4">
                        <div class="text-yellow-400 text-4xl mb-3">
                            <i class="fas fa-comment-slash"></i>
                        </div>
                        <p class="text-gray-500 text-sm">Henüz mesajınız yok</p>
                    </li>
                {% endfor %}
            </ul>
            
            <div id="arama-sonucu-yok" class="hidden text-center py-8 px-4">
                <div class="text-yellow-400 text-4xl mb-3">
                    <i class="fas fa-search"></i>
                </div>
                <p class="text-gray-700 font-medium mb-2">Kullanıcı bulunamadı</p>
                <p class="text-gray-500 text-sm">Aradığınız kriterlere uygun kullanıcı bulunamadı.</p>
            </div>
        </div>
    </div>
    
    <!-- Sağ taraf - Mesajlaşma alanı -->
    <div class="flex-1 flex flex-col h-screen w-full">
        <!-- Mobil için başlık ve menü butonu -->
        <div class="bg-yellow-500 px-4 py-4 flex-shrink-0 flex items-center md:hidden">
            <button onclick="window.history.back()" class="text-white mr-3">
                <i class="fas fa-arrow-left"></i>
            </button>
            <button id="ac-menu" class="text-white mr-3">
                <i class="fas fa-bars"></i>
            </button>
            <div class="flex items-center">
                <img src="{% if other_user.avatar %}{{ other_user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                     alt="Profil" class="w-8 h-8 rounded-full object-cover mr-2 border-2 border-white">
                <span class="font-semibold text-white text-sm">
                    <a href="/uygulama/@{{other_user.slug}}" class="hover:underline">{{ other_user.get_full_name }}</a>
                </span>
            </div>
        </div>
        
        <div class="flex flex-col w-full h-full bg-white rounded-xl shadow-md overflow-hidden md:rounded-none md:shadow-none">
            <!-- Masaüstü başlık (mobilde gizli) -->
            <div class="hidden md:flex items-center justify-between p-4 bg-yellow-500 border-b border-yellow-600 flex-shrink-0">
                <div class="flex items-center">
                    <img src="{% if other_user.avatar %}{{ other_user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                         alt="Profil" class="w-10 h-10 rounded-full object-cover mr-3 border-2 border-white">
                    <span class="font-semibold text-white">
                        <a href="/uygulama/@{{other_user.slug}}" class="hover:underline">{{ other_user.get_full_name }}</a>
                    </span>
                </div>
            </div>

            <!-- Mesajlar scrollable -->
    <div id="messages" class="flex-1 p-4 overflow-y-auto bg-gray-50">
                <div class="text-center mb-6">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-yellow-100 text-yellow-600 mb-2">
                        <i class="fas fa-user-friends text-xl"></i>
                    </div>
                    <p class="text-sm text-gray-500">{{ other_user.get_full_name }} ile mesajlaşmaya başlayın</p>
                </div>
            </div>

            <!-- Mesaj yazma formu sabit -->
            <form method="post" class="flex items-center p-3 md:p-4 bg-white border-t border-gray-200 flex-shrink-0">
        {% csrf_token %}
        <input type="text" name="text" placeholder="Mesaj yaz..." 
               class="flex-1 p-2 md:p-3 bg-gray-100 border-none rounded-full mr-1 md:mr-2 focus:outline-none focus:ring-2 focus:ring-yellow-500">
        <button type="submit" class="p-2 md:p-3 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition flex items-center justify-center">
            <i class="fas fa-paper-plane text-sm md:text-base"></i>
        </button>
    </form>
        </div>
    </div>
</div>

<!-- Mesaj şablonu (gizli) -->
<template id="message-template">
    <div class="my-2 flex">
        <div class="max-w-xs md:max-w-md break-words px-4 py-2 rounded-xl"></div>
    </div>
</template>
{% endblock %}

{% block scripts %}
<script>
function sohbetAc(dmID) {
    // Masaüstünde normal yönlendirme
    if (window.innerWidth >= 768) {
        window.location.href = "/mesajlar/" + dmID + "/";
        return;
    }
    
    // Mobilde AJAX ile sohbet içeriğini yükle
    fetch("/mesajlar/" + dmID + "/")
        .then(response => response.text())
        .then(data => {
            // Sohbet panelini göster, kullanıcı listesini gizle
            document.getElementById('kullanici-listesi-panel').classList.add('hidden');
            document.getElementById('sohbet-panel').classList.remove('hidden');
            document.getElementById('sohbet-panel').innerHTML = data;
            document.getElementById('geri-buton').classList.remove('hidden');
        })
        .catch(error => {
            console.error('Hata:', error);
            window.location.href = "/mesajlar/" + dmID + "/";
        });
}

const dmId = {{ dm.id }};
const messagesContainer = document.getElementById('messages');
let lastId = 0;
const messageTemplate = document.getElementById('message-template');

function fetchMessages() {
    fetch(`/mesajlar/${dmId}/messages-long/?last_id=${lastId}`)
        .then(res => res.json())
        .then(data => {
            if (data.length) {
                data.forEach(msg => {
                    const messageDiv = messageTemplate.content.cloneNode(true);
                    const container = messageDiv.querySelector('.my-2');
                    const messageBubble = messageDiv.querySelector('.max-w-xs');
                    
                    if (msg.sender === '{{ request.user.get_full_name }}') {
                        container.classList.add('justify-end');
                        messageBubble.classList.add('bg-yellow-500', 'text-white', 'rounded-br-none');
                    } else {
                        container.classList.add('justify-start');
                        messageBubble.classList.add('bg-gray-200', 'text-gray-800', 'rounded-bl-none');
                    }
                    
                    messageBubble.textContent = msg.text;
                    messagesContainer.appendChild(messageDiv);
                    lastId = msg.id;
                });
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
                
                const welcomeMessage = messagesContainer.querySelector('.text-center');
                if (welcomeMessage && data.length > 0) {
                    welcomeMessage.style.display = 'none';
                }
            }
            setTimeout(fetchMessages, 1000);
        })
        .catch(err => {
            console.error('Mesajlar yüklenirken hata:', err);
            setTimeout(fetchMessages, 2000);
        });
}

document.addEventListener('DOMContentLoaded', function() {
    fetchMessages();
    
    // Menü yönetimi
    const kullaniciListesiPanel = document.getElementById('kullanici-listesi-panel');
    const acMenuBtn = document.getElementById('ac-menu');
    const kapatMenuBtn = document.getElementById('kapat-menu');
    
    acMenuBtn.addEventListener('click', function() {
        kullaniciListesiPanel.classList.remove('-translate-x-full');
    });
    
    kapatMenuBtn.addEventListener('click', function() {
        kullaniciListesiPanel.classList.add('-translate-x-full');
    });
    
    // Arama fonksiyonelliği
    const aramaInput = document.getElementById('kullanici-ara');
    const kullaniciItems = document.querySelectorAll('.kullanici-item');
    const aramaSonucuYok = document.getElementById('arama-sonucu-yok');
    
    aramaInput.addEventListener('input', function() {
        const aramaMetni = this.value.toLowerCase().trim();
        let bulunanOgeSayisi = 0;
        
        kullaniciItems.forEach(item => {
            const isim = item.querySelector('.text-sm.font-medium').textContent.toLowerCase();
            
            if (isim.includes(aramaMetni)) {
                item.style.display = 'flex';
                bulunanOgeSayisi++;
            } else {
                item.style.display = 'none';
            }
        });
        
        if (aramaMetni.length > 0 && bulunanOgeSayisi === 0) {
            aramaSonucuYok.classList.remove('hidden');
        } else {
            aramaSonucuYok.classList.add('hidden');
        }
        
        if (aramaMetni.length === 0) {
            kullaniciItems.forEach(item => {
                item.style.display = 'flex';
            });
            aramaSonucuYok.classList.add('hidden');
        }
    });
    
    // Mesaj gönderme
    const form = document.querySelector('form');
    form.addEventListener('submit', e => {
        e.preventDefault();
        const input = form.querySelector('input[name="text"]');
        const text = input.value.trim();
        if (!text) return;

        input.value = ''; // <- hemen temizle

        fetch(`/mesajlar/${dmId}/send/`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json', 
                'X-CSRFToken': '{{ csrf_token }}'
            },
            body: JSON.stringify({text})
        })
        .then(res => res.json())
        .then(data => {
            // mesaj ekleme işlemleri
        })
        .catch(err => console.error(err));
    });

    
    const messageInput = form.querySelector('input[name="text"]');
    messageInput.focus();
    
    messageInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            form.dispatchEvent(new Event('submit'));
        }
    });
    
    // Ekran boyutu değişikliğini dinle
    window.addEventListener('resize', function() {
        if (window.innerWidth >= 768) {
            // Masaüstü görünümünde menüyü göster
            kullaniciListesiPanel.classList.remove('-translate-x-full');
        } else {
            // Mobil görünümünde menüyü gizle
            kullaniciListesiPanel.classList.add('-translate-x-full');
        }
    });
});
</script>

<style>
/* Scrollbar stilleri */
#messages, #kullanici-listesi {
    scrollbar-width: thin;
    scrollbar-color: #e5e7eb #f9fafb;
}

#messages::-webkit-scrollbar,
#kullanici-listesi::-webkit-scrollbar {
    width: 6px;
}

#messages::-webkit-scrollbar-track,
#kullanici-listesi::-webkit-scrollbar-track {
    background: #f9fafb;
    border-radius: 3px;
}

#messages::-webkit-scrollbar-thumb,
#kullanici-listesi::-webkit-scrollbar-thumb {
    background-color: #e5e7eb;
    border-radius: 3px;
}

/* Yellow 500 renk tonları */
.bg-yellow-500 { background-color: #eab308; }
.hover\:bg-yellow-600:hover { background-color: #ca8a04; }
.bg-yellow-50 { background-color: #fefce8; }
.bg-yellow-100 { background-color: #fef9c3; }
.border-yellow-200 { border-color: #fef08a; }
.border-yellow-600 { border-color: #ca8a04; }
.focus\:ring-yellow-500:focus { --tw-ring-color: #eab308; }
.text-yellow-500 { color: #eab308; }
.hover\:text-yellow-600:hover { color: #ca8a04; }

/* Mesaj alanı ve form */
/* Mesaj alanı */
#messages {
    flex: 1 1 auto;      /* Esnek büyüme */
    overflow-y: auto;     /* Dikey kaydırma */
    padding: 1rem;
    background-color: #f9fafb;
}

/* Mesaj yazma formunu yukarı al */
form {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
    position: sticky;     /* Yukarıda sabit */
    top: 0rem;            /* Biraz aşağıdan başlasın */
    z-index: 5;
    margin-bottom: 4rem;  /* Alt boşluk */
    border-radius: 0.5rem;
}


/* Mobil için ek stiller */
@media (max-width: 767px) {
    #kullanici-listesi-panel {
        width: 85%;
        max-width: 320px;
        box-shadow: 4px 0 10px rgba(0, 0, 0, 0.1);
    }

    .max-w-xs {
        max-width: 70%;
    }

    #messages {
        padding-bottom: 4rem; /* Formun üstüne gelmesini önler */
    }
}

</style>
{% endblock %}