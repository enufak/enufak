<template id="message-template">
    <div class="message-wrapper mb-3">
        <div class="message-bubble relative max-w-xs lg:max-w-md px-4 py-3 rounded-2xl shadow-md transition-all duration-200 hover:shadow-lg">
            <p class="text-sm md:text-base text-gray-800 leading-relaxed"></p>
            <div class="flex justify-end items-center mt-2 space-x-2">
                <span class="message-time text-xs text-gray-500 font-medium"></span>
                <span class="message-status relative group hidden">
                    <i class="fas fa-check text-xs"></i>
                    <div class="absolute bottom-full right-0 mb-2 hidden group-hover:block">
                        <div class="bg-black/90 text-white text-xs py-1 px-2 rounded whitespace-nowrap">
                            <span class="status-text"></span>
                        </div>
                        <div class="absolute -bottom-1 right-2 w-2 h-2 bg-black/90 transform rotate-45"></div>
                    </div>
                </span>
            </div>
