                    class="fixed inset-0 z-50 flex items-center justify-center hidden">
                    <div class="absolute inset-0 bg-black/20 backdrop-blur-sm" id="emoji-backdrop"></div>
                    <div class="relative bg-white rounded-2xl shadow-2xl border border-amber-200 w-full max-w-md mx-4 transform transition-all duration-300 scale-95 opacity-0">
                        <div class="p-4">
