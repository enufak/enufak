{% block scripts %}
<script>
const messagesContainer = document.getElementById('messages-container');
const messageInput = document.getElementById('message-input');
const sendButton = document.getElementById('send-button');
const dmId = {{ dm.id }};
let lastMessageId = 0;

const statusConfig = {
    sent: { icon: '<i class="fas fa-check text-gray-400"></i>', text: 'Gönderildi' },
    delivered: { icon: '<i class="fas fa-check-double text-gray-400"></i>', text: 'İletildi' },
    read: { icon: '<i class="fas fa-check-double text-amber-500"></i>', text: 'Okundu' }
};

async function sendMessage() {
    const text = messageInput.value.trim();
    if (!text) return;
    
    const tempId = 'temp_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
    
    addMessageToUI({
        id: tempId,
        text: text,
        sender: '{{ request.user.get_full_name }}',
        created_at: new Date().toISOString(),
        okunma: false,
        isTemp: true
    }, true);
    
    messageInput.value = '';
    sendButton.disabled = true;
    sendButton.classList.remove('hover:-translate-y-0.5', 'hover:shadow-lg');
    
    try {
        const response = await fetch(`/mesajlar/${dmId}/send/`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': '{{ csrf_token }}'
            },
            body: JSON.stringify({text: text})
        });
        
        if (!response.ok) throw new Error('Mesaj gönderilemedi');
        
        const tempMessage = document.querySelector(`[data-temp-id="${tempId}"]`);
        if (tempMessage) {
            tempMessage.style.opacity = '0.7';
        }
        
    } catch (error) {
        console.error('Mesaj gönderim hatası:', error);
        showToast('Mesaj gönderilemedi. Lütfen tekrar deneyin.', 'error');
        
        const tempMessage = document.querySelector(`[data-temp-id="${tempId}"]`);
        if (tempMessage) {
            tempMessage.remove();
            showToast('Mesaj gönderilemedi. Lütfen tekrar deneyin.', 'error');
        }
    }
}

function addMessageToUI(message, isOwn = false) {
    const template = document.getElementById('message-template');
    const clone = template.content.cloneNode(true);
    
    const wrapper = clone.querySelector('.message-wrapper');
    const bubble = clone.querySelector('.message-bubble');
    const text = clone.querySelector('p');
    const time = clone.querySelector('.message-time');
    const status = clone.querySelector('.message-status');
    const statusIcon = status.querySelector('i');
    const statusText = clone.querySelector('.status-text');
    
    text.textContent = message.text;
    
    const date = new Date(message.created_at);
    time.textContent = date.toLocaleTimeString('tr-TR', { 
        hour: '2-digit', 
        minute: '2-digit',
        hour12: false 
    });
    
    if (message.isTemp) {
        wrapper.setAttribute('data-temp-id', message.id);
        wrapper.classList.add('opacity-80');
    } else {
        wrapper.setAttribute('data-message-id', message.id);
    }
    
    if (isOwn) {
        wrapper.classList.add('flex', 'justify-end');
        bubble.classList.add('bg-gradient-to-r', 'from-amber-100', 'to-yellow-100', 'border', 'border-amber-200', 'rounded-br-none');
        
        if (message.okunma) {
            status.innerHTML = statusConfig.read.icon;
            statusText.textContent = statusConfig.read.text;
        } else {
            status.innerHTML = statusConfig.sent.icon;
            statusText.textContent = statusConfig.sent.text;
        }
        
        bubble.innerHTML += '<div class="absolute -right-2 bottom-0 w-0 h-0 border-l-[10px] border-l-transparent border-t-[10px] border-t-amber-100 border-r-0 border-b-0"></div>';
    } else {
        wrapper.classList.add('flex', 'justify-start');
        bubble.classList.add('bg-white', 'border', 'border-gray-200', 'rounded-bl-none');
        
        status.remove();
        
        bubble.innerHTML += '<div class="absolute -left-2 bottom-0 w-0 h-0 border-r-[10px] border-r-transparent border-t-[10px] border-t-white border-l-0 border-b-0"></div>';
    }
    
    messagesContainer.appendChild(clone);
    scrollToBottom();
    
    const welcomeMessage = messagesContainer.querySelector('.text-center');
    if (welcomeMessage) {
        welcomeMessage.style.display = 'none';
    }
}

async function fetchMessages() {
    try {
        const response = await fetch(`/mesajlar/${dmId}/messages-long/?last_id=${lastMessageId}`);
        if (!response.ok) return;
        
        const messages = await response.json();
        
        messages.forEach(message => {
            const existingMessage = document.querySelector(`[data-message-id="${message.id}"]`);
            const tempMessages = document.querySelectorAll('[data-temp-id]');
            
            if (tempMessages.length > 0 && !existingMessage) {
                const lastTempMessage = tempMessages[tempMessages.length - 1];
                const tempText = lastTempMessage.querySelector('p').textContent;
                
                if (tempText === message.text) {
                    lastTempMessage.removeAttribute('data-temp-id');
                    lastTempMessage.setAttribute('data-message-id', message.id);
                    lastTempMessage.classList.remove('opacity-80');
                    
                    const timeElement = lastTempMessage.querySelector('.message-time');
                    const date = new Date(message.created_at);
                    timeElement.textContent = date.toLocaleTimeString('tr-TR', { 
                        hour: '2-digit', 
                        minute: '2-digit',
                        hour12: false 
                    });
                    
                    return;
                }
            }
            
            if (!existingMessage) {
                const isOwn = message.sender === '{{ request.user.get_full_name }}';
                addMessageToUI(message, isOwn);
                lastMessageId = Math.max(lastMessageId, message.id);
            }
        });
        
        setTimeout(() => {
            const oldTempMessages = document.querySelectorAll('[data-temp-id]');
            oldTempMessages.forEach(tempMsg => {
                const tempId = tempMsg.getAttribute('data-temp-id');
                if (tempId && tempId.startsWith('temp_')) {
                    const timestamp = parseInt(tempId.split('_')[1]);
                    if (Date.now() - timestamp > 10000) {
                        tempMsg.remove();
                    }
                }
            });
        }, 5000);        
    } catch (error) {
        console.error('Mesajlar yüklenirken hata:', error);
    }
}

function showToast(message, type = 'info') {
    const toast = document.createElement('div');
    toast.className = `fixed top-4 right-4 z-50 px-4 py-3 rounded-lg shadow-lg transform transition-all duration-300 ${
        type === 'error' ? 'bg-red-500 text-white' : 'bg-amber-500 text-white'
    }`;
    toast.textContent = message;
    document.body.appendChild(toast);
    
    setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-full');
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}

function scrollToBottom() {
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
}

document.addEventListener('DOMContentLoaded', function() {
    fetchMessages();
    
    setInterval(fetchMessages, 1500);
    
    messageInput.addEventListener('input', function() {
        const hasText = this.value.trim().length > 0;
        sendButton.disabled = !hasText;
        if (hasText) {
            sendButton.classList.add('hover:-translate-y-0.5', 'hover:shadow-lg');
        } else {
            sendButton.classList.remove('hover:-translate-y-0.5', 'hover:shadow-lg');
        }
    });
    
    messageInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (this.value.trim()) {
                sendMessage();
            }
        }
    });
    
    sendButton.addEventListener('click', sendMessage);
    
    const kullaniciListesiPanel = document.getElementById('kullanici-listesi-panel');
    const acMenuBtn = document.getElementById('ac-menu');
    const kapatMenuBtn = document.getElementById('kapat-menu');
    
    acMenuBtn?.addEventListener('click', () => {
        kullaniciListesiPanel.classList.remove('-translate-x-full');
        kullaniciListesiPanel.classList.add('shadow-2xl');
    });
    
    kapatMenuBtn?.addEventListener('click', () => {
        kullaniciListesiPanel.classList.add('-translate-x-full');
        kullaniciListesiPanel.classList.remove('shadow-2xl');
    });
    
    const aramaInput = document.getElementById('kullanici-ara');
    aramaInput?.addEventListener('input', function() {
        const searchText = this.value.toLowerCase().trim();
        const chatItems = document.querySelectorAll('.chat-list-item');
        const aramaSonucuYok = document.getElementById('arama-sonucu-yok');
        let bulunanOgeSayisi = 0;
        
        chatItems.forEach(item => {
            const isim = item.getAttribute('data-isim') || '';
            const kullaniciadi = item.getAttribute('data-kullaniciadi') || '';
            
            if (isim.includes(searchText) || kullaniciadi.includes(searchText)) {
                item.style.display = 'flex';
                bulunanOgeSayisi++;
            } else {
                item.style.display = 'none';
            }
        });
        
        aramaSonucuYok.classList.toggle('hidden', bulunanOgeSayisi > 0 || searchText.length === 0);
    });
    
    window.addEventListener('resize', function() {
        if (window.innerWidth >= 768) {
            kullaniciListesiPanel.classList.remove('-translate-x-full', 'shadow-2xl');
        }
    });
    
    setTimeout(scrollToBottom, 100);
    
    messageInput.focus();
});

document.addEventListener("DOMContentLoaded", () => {
    const emojiBtn = document.getElementById("emoji-button");
    const emojiModal = document.getElementById("emoji-picker-modal");
    const emojiClose = document.getElementById("emoji-close");
    const emojiBackdrop = document.getElementById("emoji-backdrop");
    const emojiItems = document.querySelectorAll(".emoji-item");
    const input = document.getElementById("message-input");

    emojiBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        emojiModal.classList.remove("hidden");
        setTimeout(() => {
            emojiModal.querySelector(".relative").classList.remove("scale-95", "opacity-0");
        }, 10);
    });

    function closeEmojiModal() {
        emojiModal.querySelector(".relative").classList.add("scale-95", "opacity-0");
        setTimeout(() => {
            emojiModal.classList.add("hidden");
        }, 300);
    }

    emojiClose.addEventListener("click", closeEmojiModal);

    emojiBackdrop.addEventListener("click", closeEmojiModal);

    emojiItems.forEach(item => {
        item.addEventListener("click", () => {
            const emoji = item.textContent;
            input.value += emoji;
            input.focus();
            input.dispatchEvent(new Event("input"));
            closeEmojiModal();
        });
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !emojiModal.classList.contains("hidden")) {
            closeEmojiModal();
        }
    });

    document.addEventListener("click", (e) => {
        if (!emojiModal.classList.contains("hidden") && 
            !emojiModal.contains(e.target) && 
            !emojiBtn.contains(e.target)) {
            closeEmojiModal();
        }
    });

    emojiItems.forEach(item => {
        item.addEventListener("mouseenter", () => {
            item.classList.add("bg-amber-200", "transform", "scale-110");
        });
        item.addEventListener("mouseleave", () => {
            item.classList.remove("bg-amber-200", "transform", "scale-110");
        });
    });
});
</script>

