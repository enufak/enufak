{% extends 'base.jinja' %}
{% load static %}

{% block title %}Mesaj - {{ other_user.get_full_name }}{% endblock %}

{% block content %}
<div class="flex flex-col md:flex-row h-[calc(100vh-80px)] md:h-[calc(100vh-80px)] bg-gradient-to-br from-amber-50 to-yellow-50">
    <div class="w-full md:w-1/3 lg:w-1/4 bg-white/90 backdrop-blur-sm border-r border-yellow-200 flex flex-col h-full absolute md:relative z-20 -translate-x-full md:translate-x-0 transition-all duration-300 shadow-xl md:shadow-none" id="kullanici-listesi-panel">
        <div class="bg-gradient-to-r from-amber-500 to-yellow-500 px-4 py-4 flex-shrink-0">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="relative">
                        <img src="{% if request.user.avatar %}{{ request.user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                             class="w-12 h-12 rounded-full object-cover border-3 border-amber-200 shadow-md" 
                             alt="{{ request.user.get_full_name }}">
                        <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white"></span>
                    </div>
                    <h1 class="ml-3 text-xl font-bold text-white drop-shadow-sm">Mesajlar</h1>
                </div>
                <div class="flex items-center space-x-2">
                    <button class="text-white/90 hover:text-white p-2 hover:bg-amber-600/30 rounded-full transition-all duration-200">
                        <i class="fas fa-edit text-sm"></i>
                    </button>
                    <button id="kapat-menu" class="md:hidden text-white/90 hover:text-white p-2 hover:bg-amber-600/30 rounded-full transition-all duration-200">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <div class="p-4 bg-gradient-to-b from-amber-50 to-yellow-50 border-b border-yellow-100 flex-shrink-0">
            <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-amber-400 group-focus-within:text-amber-600 transition-colors"></i>
                </div>
                <input type="text" id="kullanici-ara" placeholder="Sohbet ara..." 
                    class="w-full pl-10 pr-4 py-3 bg-white border-2 border-yellow-200 rounded-xl focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200 focus:ring-opacity-50 text-sm placeholder-amber-400 transition-all duration-300 shadow-sm hover:shadow-md">
            </div>
        </div>
        
        <div class="flex-1 overflow-y-auto bg-gradient-to-b from-white to-amber-50/30">
            {% for dm in dmler %}
                {% if dm.from_user == request.user %}
                    {% with user=dm.to_user %}
                        {% include 'partials/chat_list_item.jinja' with user=user dm=dm %}
                    {% endwith %}
                {% else %}
                    {% with user=dm.from_user %}
                        {% include 'partials/chat_list_item.jinja' with user=user dm=dm %}
                    {% endwith %}
                {% endif %}
            {% empty %}
                <div class="text-center py-16 px-4">
                    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-amber-100 to-yellow-100 text-amber-400 mb-4 shadow-inner">
                        <i class="fas fa-comments text-3xl"></i>
                    </div>
                    <p class="text-amber-700 font-semibold mb-2 text-lg">Henüz mesajınız yok</p>
                    <p class="text-amber-500 text-sm max-w-xs mx-auto">Yeni bir sohbet başlatmak için kullanıcı arayın</p>
                </div>
            {% endfor %}
            
            <div id="arama-sonucu-yok" class="hidden text-center py-16 px-4">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-amber-100 to-yellow-100 text-amber-400 mb-4 shadow-inner">
                    <i class="fas fa-search text-3xl"></i>
                </div>
                <p class="text-amber-700 font-semibold mb-2 text-lg">Sonuç bulunamadı</p>
                <p class="text-amber-500 text-sm">Farklı bir isimle aramayı deneyin</p>
            </div>
        </div>
    </div>
    
    <div class="flex-1 flex flex-col h-full w-full">
        <div class="md:hidden bg-gradient-to-r from-amber-500 to-yellow-500 px-4 py-3 flex-shrink-0 shadow-lg">
            <div class="flex items-center">
                <button id="ac-menu" class="text-white/90 hover:text-white mr-3 p-2 hover:bg-amber-600/30 rounded-full transition-all duration-200">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="flex items-center flex-1">
                    <div class="relative">
                        <img src="{% if other_user.avatar %}{{ other_user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                             alt="{{ other_user.get_full_name }}" class="w-10 h-10 rounded-full object-cover border-3 border-amber-200 shadow-sm">
                        {% if other_user.is_online %}
                        <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white animate-pulse"></span>
                        {% endif %}
                    </div>
                    <div class="ml-3">
                        <span class="font-bold text-white text-sm block leading-tight">
                            {{ other_user.get_full_name }}
                        </span>
                        <span class="text-amber-100 text-xs font-medium">
                            {% if other_user.is_online %}çevrimiçi{% else %}çevrimdışı{% endif %}
                        </span>
                    </div>
                </div>
                <div class="flex items-center space-x-1">
                    <a href="{% url 'start_call' to_user_id=other_user.id %}" class="p-2 rounded-full hover:bg-amber-600/30 text-white transition-all duration-200 group relative" title="Görüntülü ara">
                        <i class="fas fa-video"></i>
                        <span class="absolute -top-8 left-1/2 transform -translate-x-1/2 bg-black/80 text-white text-xs py-1 px-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">Görüntülü ara</span>
                    </a>
                </div>
            </div>
        </div>
        
        <div class="hidden md:flex items-center justify-between px-6 py-4 bg-gradient-to-r from-amber-500 to-yellow-500 shadow-lg">
            <div class="flex items-center">
                <div class="relative">
                    <img src="{% if other_user.avatar %}{{ other_user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                         alt="{{ other_user.get_full_name }}" class="w-12 h-12 rounded-full object-cover border-3 border-amber-200 shadow-lg">
                    {% if other_user.is_online %}
                    <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white animate-pulse"></span>
                    {% endif %}
                </div>
                <div class="ml-4">
                    <span class="font-bold text-white text-lg block leading-tight">
