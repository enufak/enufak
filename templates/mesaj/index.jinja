{% extends 'base.jinja' %}
{% load static %}

{% block title %}Mesajlarım{% endblock %}

{% block content %}
<div class="flex flex-col md:flex-row h-[calc(100vh-80px)] bg-gradient-to-br from-amber-50 to-yellow-50">
    <div class="w-full md:w-1/3 lg:w-1/4 bg-white/90 backdrop-blur-sm border-r border-yellow-200 flex flex-col h-full">
        <div class="bg-gradient-to-r from-amber-500 to-yellow-500 px-6 py-5 flex-shrink-0 shadow-lg">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <div class="relative">
                        <img src="{% if request.user.avatar %}{{ request.user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                             class="w-12 h-12 rounded-full object-cover border-3 border-amber-200 shadow-md" 
                             alt="{{ request.user.get_full_name }}">
                        <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white"></span>
                    </div>
                    <h1 class="ml-4 text-xl font-bold text-white drop-shadow-sm">Mesajlarım</h1>
                </div>
            </div>
        </div>
        
        <div class="p-4 bg-gradient-to-b from-amber-50 to-yellow-50 border-b border-yellow-100 flex-shrink-0">
            <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-amber-400 group-focus-within:text-amber-600 transition-colors"></i>
                </div>
                <input type="text" id="kullanici-ara" placeholder="Sohbet ara..." 
                    class="w-full pl-10 pr-4 py-3 bg-white border-2 border-yellow-200 rounded-xl focus:outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-200 focus:ring-opacity-50 text-sm placeholder-amber-400 transition-all duration-300 shadow-sm hover:shadow-md">
            </div>
        </div>
        
        <div class="flex-1 overflow-y-auto bg-gradient-to-b from-white to-amber-50/30">
            {% for dm in dmler %}
                {% if dm.from_user == request.user %}
                    {% with user=dm.to_user %}
                        {% include 'partials/chat_list_item_main.jinja' with user=user dm=dm %}
                    {% endwith %}
                {% else %}
                    {% with user=dm.from_user %}
                        {% include 'partials/chat_list_item_main.jinja' with user=user dm=dm %}
                    {% endwith %}
                {% endif %}
            {% empty %}
                <div class="text-center py-16 px-4">
                    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-amber-100 to-yellow-100 text-amber-400 mb-4 shadow-inner">
                        <i class="fas fa-comments text-3xl"></i>
                    </div>
                    <p class="text-amber-700 font-semibold mb-2 text-lg">Henüz mesajınız yok</p>
                    <p class="text-amber-500 text-sm max-w-xs mx-auto">Yeni bir sohbet başlatmak için kullanıcı arayın</p>
                </div>
            {% endfor %}
            
            <div id="arama-sonucu-yok" class="hidden text-center py-16 px-4">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-amber-100 to-yellow-100 text-amber-400 mb-4 shadow-inner">
                    <i class="fas fa-search text-3xl"></i>
                </div>
                <p class="text-amber-700 font-semibold mb-2 text-lg">Sonuç bulunamadı</p>
                <p class="text-amber-500 text-sm">Farklı bir isimle aramayı deneyin</p>
            </div>
        </div>
    </div>
    
    <div class="hidden md:flex flex-1 flex-col items-center justify-center relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23fbbf24\" fill-opacity=\"0.03\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-30"></div>
        
        <div class="relative bg-white/90 backdrop-blur-sm rounded-2xl p-8 max-w-md mx-4 border border-amber-200 shadow-xl">
            <div class="flex flex-col items-center">
                <div class="relative mb-6">
                    <div class="w-24 h-24 rounded-full bg-gradient-to-br from-amber-100 to-yellow-100 flex items-center justify-center shadow-inner">
                        <i class="fas fa-comments text-4xl text-amber-600"></i>
                    </div>
                    <div class="absolute -top-2 -right-2 w-10 h-10 rounded-full bg-gradient-to-r from-amber-500 to-yellow-500 flex items-center justify-center text-white shadow-lg">
                        <i class="fas fa-arrow-left"></i>
                    </div>
                </div>
                
                <h3 class="text-2xl font-bold text-amber-800 mb-3 text-center">Bir sohbet seçin</h3>
                <p class="text-amber-600 text-center mb-6 leading-relaxed">
                    Sol taraftaki listeden bir sohbet seçerek mesajlaşmaya başlayın veya yeni bir sohbet başlatın.
                </p>
                
                <div class="w-full space-y-4">
                    <div class="flex items-center p-3 bg-gradient-to-r from-amber-50 to-yellow-50 rounded-xl border border-amber-200">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-amber-500 to-yellow-500 flex items-center justify-center text-white mr-3">
                            <i class="fas fa-search"></i>
                        </div>
                        <div>
                            <p class="font-semibold text-amber-800">Sohbet Ara</p>
                            <p class="text-sm text-amber-600">Yukarıdaki arama kutusundan kullanıcı bulun</p>
                        </div>
                    </div>
                </div>
                
                <div class="mt-8 pt-6 border-t border-amber-200 w-full">
                    <p class="text-xs text-amber-500 text-center">
                        <i class="fas fa-lightbulb mr-1"></i>
                        İpucu: Kullanıcıların yanındaki yeşil nokta çevrimiçi olduklarını gösterir
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function sohbetAc(dmID) {
    window.location.href = "/mesajlar/" + dmID + "/";
}

document.addEventListener('DOMContentLoaded', function() {
    const aramaInput = document.getElementById('kullanici-ara');
    const kullaniciItems = document.querySelectorAll('.chat-list-item');
    const aramaSonucuYok = document.getElementById('arama-sonucu-yok');
    
    kullaniciItems.forEach(item => {
        item.addEventListener('click', function() {
            document.querySelectorAll('.chat-list-item').forEach(li => {
                li.classList.remove('bg-gradient-to-r', 'from-amber-100', 'to-yellow-100');
                li.classList.remove('border-amber-300');
            });
            this.classList.add('bg-gradient-to-r', 'from-amber-100', 'to-yellow-100');
            this.classList.add('border-amber-300');
        });
    });
    
    aramaInput.addEventListener('input', function() {
        const aramaMetni = this.value.toLowerCase().trim();
        let bulunanOgeSayisi = 0;
        
        kullaniciItems.forEach(item => {
            const isim = item.getAttribute('data-isim') || '';
            const kullaniciadi = item.getAttribute('data-kullaniciadi') || '';
            
            if (isim.includes(aramaMetni) || kullaniciadi.includes(aramaMetni)) {
                item.style.display = 'flex';
                bulunanOgeSayisi++;
            } else {
                item.style.display = 'none';
            }
        });
        
        if (aramaMetni.length > 0 && bulunanOgeSayisi === 0) {
            aramaSonucuYok.classList.remove('hidden');
        } else {
            aramaSonucuYok.classList.add('hidden');
        }
        
        if (aramaMetni.length === 0) {
            kullaniciItems.forEach(item => {
                item.style.display = 'flex';
            });
            aramaSonucuYok.classList.add('hidden');
        }
    });
    
    const listContainer = document.querySelector('.flex-1.overflow-y-auto');
    if (listContainer) {
        listContainer.style.scrollbarWidth = 'thin';
        listContainer.style.scrollbarColor = 'rgba(251, 191, 36, 0.5) transparent';
    }
});
</script>

<style>
.h-\[calc\(100vh-80px\)\] {
    height: calc(100vh - 80px) !important;
}

.flex-1.overflow-y-auto {
    scrollbar-width: thin;
    scrollbar-color: rgba(251, 191, 36, 0.5) transparent;
}

.flex-1.overflow-y-auto::-webkit-scrollbar {
    width: 8px;
}

.flex-1.overflow-y-auto::-webkit-scrollbar-track {
    background: rgba(254, 243, 199, 0.3);
    border-radius: 4px;
}

.flex-1.overflow-y-auto::-webkit-scrollbar-thumb {
    background: linear-gradient(to bottom, #fbbf24, #f59e0b);
    border-radius: 4px;
}

.flex-1.overflow-y-auto::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(to bottom, #f59e0b, #d97706);
}

.border-3 {
    border-width: 3px;
}

* {
    transition-property: all;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 200ms;
}

@media (max-width: 767px) {
    .h-\[calc\(100vh-80px\)\] {
        height: calc(100vh - 64px) !important;
    }
    
    .hidden.md\:flex {
        display: none !important;
    }
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
}

.chat-list-item {
    animation: fadeIn 0.3s ease-out;
}

.chat-list-item:hover {
    transform: translateX(4px);
    box-shadow: 0 4px 12px rgba(251, 191, 36, 0.15);
}
</style>
{% endblock %}