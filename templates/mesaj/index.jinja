{% extends 'base.jinja' %}
{% load static %}

{% block title %}Mesajlarım{% endblock %}

{% block content %}
<div class="flex h-screen bg-gray-100">
    <!-- Sol sidebar - Kullanıcı listesi -->
    <div class="w-1/3 bg-white border-r border-gray-200 flex flex-col">
        <!-- Başlık -->
        <div class="bg-yellow-500 px-4 py-4">
            <h1 class="text-xl font-bold text-white flex items-center">
                <i class="fas fa-comments mr-2"></i>Mesajlarım
            </h1>
        </div>
        
        <!-- Arama kutusu -->
        <div class="p-3 bg-white border-b border-gray-200">
            <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-gray-400"></i>
                </div>
                <input type="text" id="kullanici-ara" placeholder="Kullanıcı ara..." 
                    class="w-full pl-10 pr-4 py-2 bg-gray-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:bg-white">
            </div>
        </div>
        
        <!-- Kullanıcı listesi -->
        <div class="flex-1 overflow-y-auto">
            <ul id="kullanici-listesi">
                {% for dm in dmler %}
                    {% if dm.from_user == request.user %}
                        {% with user=dm.to_user %}
                            <li class="kullanici-item flex items-center p-3 border-b border-gray-100 hover:bg-yellow-50 cursor-pointer transition"
                                onclick="sohbetAc({{ dm.id }})"
                                data-isim="{{ user.get_full_name|lower }}"
                                data-kullaniciadi="{{ user.username|lower }}">
                                <div class="relative flex-shrink-0">
                                    <img src="{% if user.avatar %}{{ user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                                         class="w-12 h-12 rounded-full object-cover border-2 border-yellow-200" 
                                         alt="{{ user.get_full_name }}">
                                    <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white"></span>
                                </div>
                                <div class="ml-3 flex-1 min-w-0">
                                    <div class="flex justify-between items-center">
                                        <p class="text-sm font-medium text-gray-900 truncate">{{ user.get_full_name }}</p>
                                        <span class="text-xs text-gray-400">{{ dm.created_at|date:"H:i" }}</span>
                                    </div>
                                    <p class="text-xs text-gray-500 truncate">Mesajlara devam etmek için tıkla...</p>
                                </div>
                            </li>
                        {% endwith %}
                    {% else %}
                        {% with user=dm.from_user %}
                            <li class="kullanici-item flex items-center p-3 border-b border-gray-100 hover:bg-yellow-50 cursor-pointer transition"
                                onclick="sohbetAc({{ dm.id }})"
                                data-isim="{{ user.get_full_name|lower }}"
                                data-kullaniciadi="{{ user.username|lower }}">
                                <div class="relative flex-shrink-0">
                                    <img src="{% if user.avatar %}{{ user.avatar.url }}{% else %}{% static 'images/blank-profile.jpg' %}{% endif %}" 
                                         class="w-12 h-12 rounded-full object-cover border-2 border-yellow-200" 
                                         alt="{{ user.get_full_name }}">
                                    <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white"></span>
                                </div>
                                <div class="ml-3 flex-1 min-w-0">
                                    <div class="flex justify-between items-center">
                                        <p class="text-sm font-medium text-gray-900 truncate">{{ user.get_full_name }}</p>
                                        <span class="text-xs text-gray-400">{{ dm.created_at|date:"H:i" }}</span>
                                    </div>
                                    <p class="text-xs text-gray-500 truncate">Mesajlara devam etmek için tıkla...</p>
                                </div>
                            </li>
                        {% endwith %}
                    {% endif %}
                {% empty %}
                    <!-- Mesaj yoksa -->
                    <li class="text-center py-8 px-4">
                        <div class="text-yellow-400 text-4xl mb-3">
                            <i class="fas fa-comment-slash"></i>
                        </div>
                        <p class="text-gray-500 text-sm">Henüz mesajınız yok</p>
                    </li>
                {% endfor %}
            </ul>
            
            <!-- Arama sonucu bulunamadı mesajı (başlangıçta gizli) -->
            <div id="arama-sonucu-yok" class="hidden text-center py-8 px-4">
                <div class="text-yellow-400 text-4xl mb-3">
                    <i class="fas fa-search"></i>
                </div>
                <p class="text-gray-700 font-medium mb-2">Kullanıcı bulunamadı</p>
                <p class="text-gray-500 text-sm">Aradığınız kriterlere uygun kullanıcı bulunamadı.</p>
            </div>
        </div>
        
        <!-- Yeni mesaj butonu -->
        <div class="p-4 border-t border-gray-200">
            <button class="w-full py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition flex items-center justify-center">
                <i class="fas fa-edit mr-2"></i>Yeni Mesaj
            </button>
        </div>
    </div>
    
    <!-- Sağ taraf - Sohbet alanı -->
    <div class="flex-1 flex flex-col">
        <!-- Boş sohbet alanı -->
        <div class="flex-1 flex flex-col items-center justify-center bg-yellow-50 border-2 border-dashed border-yellow-200 m-4 rounded-lg">
            <div class="text-yellow-400 text-5xl mb-4">
                <i class="fas fa-comments"></i>
            </div>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">Bir sohbet seçin</h3>
            <p class="text-gray-500 text-center max-w-md mb-6">
                Sol taraftaki listeden bir sohbet seçerek mesajlaşmaya başlayın veya yeni bir mesaj oluşturun.
            </p>
            <button class="px-6 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 transition inline-flex items-center">
                <i class="fas fa-plus mr-2"></i> Yeni Sohbet Başlat
            </button>
        </div>
    </div>
</div>

<script>
function sohbetAc(dmID) {
    // Aktif sohbeti göster
    document.querySelector('.bg-yellow-50').classList.add('hidden');
    
    // Sohbet detaylarını yükle
    window.location.href = "/mesajlar/" + dmID + "/";
}

// Sayfa yüklendiğinde
document.addEventListener('DOMContentLoaded', function() {
    const aramaInput = document.getElementById('kullanici-ara');
    const kullaniciItems = document.querySelectorAll('.kullanici-item');
    const aramaSonucuYok = document.getElementById('arama-sonucu-yok');
    
    // Kullanıcı listesindeki tıklamaları dinle
    kullaniciItems.forEach(item => {
        item.addEventListener('click', function() {
            // Tıklanan öğeyi vurgula
            document.querySelectorAll('.kullanici-item').forEach(li => {
                li.classList.remove('bg-yellow-100');
            });
            this.classList.add('bg-yellow-100');
        });
    });
    
    // Arama inputu dinleyicisi
    aramaInput.addEventListener('input', function() {
        const aramaMetni = this.value.toLowerCase().trim();
        let bulunanOgeSayisi = 0;
        
        // Her kullanıcı öğesini kontrol et
        kullaniciItems.forEach(item => {
            const isim = item.getAttribute('data-isim');
            const kullaniciadi = item.getAttribute('data-kullaniciadi');
            
            // Arama metni ile eşleşme kontrolü
            if (isim.includes(aramaMetni) || kullaniciadi.includes(aramaMetni)) {
                item.style.display = 'flex';
                bulunanOgeSayisi++;
            } else {
                item.style.display = 'none';
            }
        });
        
        // Arama sonucu yoksa mesajı göster
        if (aramaMetni.length > 0 && bulunanOgeSayisi === 0) {
            aramaSonucuYok.classList.remove('hidden');
        } else {
            aramaSonucuYok.classList.add('hidden');
        }
        
        // Arama kutusu boşsa tüm öğeleri göster
        if (aramaMetni.length === 0) {
            kullaniciItems.forEach(item => {
                item.style.display = 'flex';
            });
            aramaSonucuYok.classList.add('hidden');
        }
    });
});
</script>

<style>
#kullanici-listesi {
    scrollbar-width: thin;
    scrollbar-color: #e5e7eb #f9fafb;
}

#kullanici-listesi::-webkit-scrollbar {
    width: 6px;
}

#kullanici-listesi::-webkit-scrollbar-track {
    background: #f9fafb;
}

#kullanici-listesi::-webkit-scrollbar-thumb {
    background-color: #e5e7eb;
    border-radius: 3px;
}

/* Yellow 500 renk tonları */
.bg-yellow-500 {
    background-color: #eab308;
}
.hover\:bg-yellow-600:hover {
    background-color: #ca8a04;
}
.bg-yellow-50 {
    background-color: #fefce8;
}
.border-yellow-200 {
    border-color: #fef08a;
}
.border-yellow-300 {
    border-color: #fde047;
}
.hover\:bg-yellow-50:hover {
    background-color: #fefce8;
}
.bg-yellow-100 {
    background-color: #fef9c3;
}
.focus\:ring-yellow-500:focus {
    --tw-ring-color: #eab308;
}
.text-yellow-500 {
    color: #eab308;
}
.hover\:text-yellow-600:hover {
    color: #ca8a04;
}
</style>
{% endblock %}